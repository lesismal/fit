# fit's config template as a directory: every field of the config and of every module's
# params, in files by kind. Generated by schema.TemplateDir; regenerate with:
# go test ./schema -update
#
# fit run -c <this directory> reads every file in it, its subdirectories too, in lexical
# order. listeners, routes, upstreams, services and providers are joined across the files;
# any other field is written in one file only. What is written out runs as it is: a
# listener on :8080, example.com answering "hello from fit", and api.example.com proxied
# to 127.0.0.1:9000. Every other field is commented out, with its default or an example:
# uncomment what you need. docs/reference/config.md describes them all.
#
# This file:
# What fit tells about itself: its own log, the access log, OpenTelemetry, request
# metrics, and the Admin API.

# fit's own log: what it says about starting, reloading, certificates, providers and the
# engine, by logger, each with the least level written. Messages at info and debug to stdout
# and the rest to stderr, at info and above, as lines of text, when left out.
# object.
# log {
	# # The least level written, of every logger levels does not name: debug, info, warn or error.
	# # info when left out. A change takes effect on reload.
	# # one of: debug, info, warn, error; default "info".
	# level info

	# # The least level of some loggers, by name, over level: server (listeners, loading and
	# # reloading configs, shutting down), admin (the Admin API), tls (certificates: ACME, OCSP,
	# # certificate files), provider (providers), telemetry (exporting over OTLP), access_log (the
	# # access log's dropped lines), plugin (wasm plugins), fastcgi (what FastCGI applications write
	# # to their stderr) and engine (fib, the network engine, and whatever else writes to Go's log
	# # and log/slog). A change takes effect on reload.
	# # object of string.
	# levels {
	# 	engine warn
	# 	tls debug
	# }

	# # "stdout", "stderr", or the path of a file messages are appended to. When left out, debug and
	# # info messages go to stdout and warn and error ones to stderr.
	# # string.
	# output /var/log/fit/fit.log

	# # text, a line "fit: " and the message, or json, a JSON object a line, with time, level,
	# # logger and msg, and the attributes of what the engine logs. text when left out.
	# # one of: text, json; default "text".
	# format text
# }

# Where a line is written for each request, as JSON; no access log when left out.
# object.
# access_log {
	# # "stdout", "stderr", or the path of a file lines are appended to; "stdout" when left out.
	# # string; default "stdout".
	# output /var/log/fit/access.log

	# # How long a line may wait in the buffer before it is written; 1s when left out.
	# # duration, as "1.5s" or "2m"; default "1s".
	# flush_interval 1s

	# # How many bytes of lines may wait to be written; lines past it are dropped. 4 MiB when left
	# # out.
	# # integer, 0 or more; default 4194304.
	# buffer_bytes 4194304

	# # The least level of the requests written: a response with a status below 400 is info, a 4xx
	# # warn and a 5xx error, so warn writes the requests answered with 4xx and 5xx, and error those
	# # answered with 5xx. Every request when left out. A change takes effect on reload.
	# # one of: info, warn, error; default "info".
	# level info
# }

# OpenTelemetry: traces of requests, with W3C trace context sent on to upstreams, and metrics,
# exported over OTLP/HTTP to a collector. Neither when left out. Read when fit starts: a
# change takes effect when fit restarts.
# object.
# telemetry {
	# # The OTLP/HTTP receiver: http:// or https:// and a host and port, as of an OpenTelemetry
	# # Collector; traces go to its /v1/traces and metrics to /v1/metrics, as JSON.
	# # http://127.0.0.1:4318 when left out.
	# # string; default "http://127.0.0.1:4318".
	# endpoint http://127.0.0.1:4318

	# # A file of header fields sent with each export, one "Name: value" a line, as an API key a
	# # receiver asks for; read when fit starts. None when left out.
	# # string.
	# headers_file /etc/fit/otlp-headers

	# # A PEM file with the CAs the receiver's certificate is verified with, over https; the
	# # system's when left out.
	# # string.
	# ca_file /etc/fit/ca.pem

	# # A PEM file with the client certificate sent over https; with key_file.
	# # string.
	# cert_file /etc/fit/example.com.pem

	# # A PEM file with cert_file's private key.
	# # string.
	# key_file /etc/fit/example.com.key

	# # The service.name of the resource traces and metrics are about. fit when left out.
	# # string; default "fit".
	# service_name fit

	# # How long an export may take, connecting included; a batch not sent by then is dropped and
	# # counted. 10s when left out.
	# # duration, as "1.5s" or "2m"; default "10s".
	# timeout 10s

	# # Trace requests: a server span for each one sampled, and its context sent on to upstreams in
	# # traceparent. No traces when left out.
	# # object.
	# traces {
		# # The share of requests traced among those whose caller did not decide: from 0 to 1. A request
		# # whose traceparent says its caller sampled it is always traced, and one that says it did not
		# # is never. 0, only those a caller sampled, when left out.
		# # number, 0 to 1.
		# sample_ratio 0.1

		# # The most bytes of spans waiting to be exported, besides the batch being sent; spans past it
		# # are dropped and counted. 4 MiB when left out or 0.
		# # integer, 0 or more; default 4194304.
		# max_queue_bytes 4194304

		# # How often spans are exported, and sooner when 256 KiB of them wait. 5s when left out.
		# # duration, as "1.5s" or "2m"; default "5s".
		# interval 5s
	# }

	# # Export the metrics the Admin API's /metrics serves, requests counted included, every
	# # interval. No metrics over OTLP when left out.
	# # object.
	# metrics {
		# # How often the metrics are exported. 30s when left out.
		# # duration, as "1.5s" or "2m"; default "30s".
		# interval 30s
	# }
# }

# The Admin API, through which the running config is read and replaced, and which serves
# metrics in Prometheus's text format at /metrics; off when left out. Its settings are read
# when fit starts: a change to them takes effect when fit restarts.
# object.
# admin {
	# # Where the Admin API listens: a host and port, or "unix/" and the path of a Unix socket, as
	# # in "unix//run/fit/admin.sock". The host must be a loopback address or localhost unless
	# # token_file is set. 127.0.0.1:2019 when left out.
	# # string; default "127.0.0.1:2019".
	# address 127.0.0.1:2019

	# # A file holding a token that every request must carry, as "Authorization: Bearer <token>"; no
	# # token is asked for when left out.
	# # string.
	# token_file /etc/fit/token

	# # How many of the configs applied, the running one included, are kept to be read back. 10 when
	# # left out or 0.
	# # integer, 0 or more; default 10.
	# history 10

	# # The largest config the Admin API takes; a larger one gets 413. 4 MiB when left out or 0.
	# # integer, 0 or more; default 4194304.
	# max_config_bytes 4194304

	# # The most connections the Admin API keeps open at once; one past it is closed as soon as it
	# # is accepted. 16 when left out or 0.
	# # integer, 0 or more; default 16.
	# max_conns 16

	# # Do not serve the dashboard, the read-only web pages at /dashboard/ that show the routes,
	# # services, upstreams and their health, certificates and config versions from the Admin API's
	# # GET endpoints; served when left out or false.
	# # boolean.
	# disable_dashboard true
# }

# Count and time requests by listener and route, for the Admin API's /metrics, which serves
# the rest of fit's metrics without it; off when left out, since it costs every request a
# little. Needs admin.
# object.
# metrics {
# }
