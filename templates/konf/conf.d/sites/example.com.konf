# fit's config template as a directory: every field of the config and of every module's
# params, in files by kind. Generated by schema.TemplateDir; regenerate with:
# go test ./schema -update
#
# fit run -c <this directory> reads every file in it, its subdirectories too, in lexical
# order. listeners, routes, upstreams, services and providers are joined across the files;
# any other field is written in one file only. What is written out runs as it is: a
# listener on :8080, example.com answering "hello from fit", and api.example.com proxied
# to 127.0.0.1:9000. Every other field is commented out, with its default or an example:
# uncomment what you need. docs/reference/config.md describes them all.
#
# This file:
# A site: the routes of example.com. Its first route answers "hello from fit"; the
# others, commented out, show every handler, and every middleware with all its params.

# How requests are matched, and what handles them.
# list of object.
route {
	# A name unique among the routes, for logs and metrics.
	# string.
	name example.com

	# The names of the listeners the route serves; every listener when left out.
	# list of string.
	# listeners web

	# Routes with a higher priority are picked first; among equal ones, the most specific host,
	# then path, then the one with the most other matchers set (method, header, query, remote_ip,
	# path_regexp, expr), then the one written first.
	# integer.
	# priority 10

	# What a request must match; every request when left out.
	# object.
	match {
		# Host names, exact, or with a leading "*." wildcard, which stands for one label, or a leading
		# "**." wildcard, which stands for one label or more, as the Gateway API's wildcards do.
		# list of string.
		host example.com www.example.com

		# Paths, exact or ending in "*" to match a prefix.
		# list of string.
		# path /api/*

		# Regular expressions in Go's syntax, matched against the path anywhere in it unless anchored
		# with ^ and $.
		# list of string.
		# path_regexp ^/v[0-9]+/

		# Methods, as in "GET"; compared as written, since methods are case-sensitive.
		# list of string.
		# method GET POST

		# Headers the request must have, each with one of the values listed as the value of one of its
		# fields, or with any value when none are listed. Names ignore case; values do not.
		# object of list of string.
		# header {
		# 	X-Env prod
		# }

		# Query parameters the request must have, each with one of the values listed, or with any
		# value when none are listed; compared once unescaped.
		# object of list of string.
		# query {
		# 	debug
		# }

		# IP addresses and CIDR prefixes, as in "10.0.0.0/8", the client's address must be in: the
		# address of the connection, not of X-Forwarded-For.
		# list of string.
		# remote_ip 10.0.0.0/8

		# An expression the request must match, combining matchers with &&, ||, ! and parentheses, as
		# in Host("a.example") && (PathPrefix("/api/") || Method("POST")). Its matchers are Host,
		# Path, PathPrefix, PathRegexp, Method, Header(name, value...), Query(key, value...) and
		# RemoteIP, whose arguments are strings quoted as in Go. It counts as one matcher in the order
		# of routes, and its hosts and paths do not make a route more specific: give it a priority.
		# string.
		# expr "Host(\"example.com\") && (PathPrefix(\"/api/\") || Method(\"POST\"))"
	}

	# Middleware a request passes through, in order, before the handler.
	# list of module.
	# # Asks for a user name and password (Basic authentication), checked against bcrypt hashes.
	# middleware basic_auth {
		# # The realm the browser shows when it asks for a user and password; fit when left out.
		# # string; default "fit".
		# realm fit

		# # The users allowed in, with their passwords' bcrypt hashes.
		# # list of object; required.
		# users {
			# # The user's name; it may not contain a colon.
			# # string; required.
			# username fit

			# # The bcrypt hash of the user's password, as fit hash-password or htpasswd -B makes it.
			# # string; required.
			# password_hash $2a$14$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG
		# }

		# # A request field to set to the user's name for the handler, and the upstream a proxy sends
		# # the request to; any the client sent is replaced.
		# # string.
		# user_header X-User

		# # Leave the Authorization field, with the password, on the request the handler sees; it is
		# # removed when left out.
		# # boolean.
		# forward_authorization true
	# }

	# # Limits the size of request bodies, answering 413 past it.
	# middleware body_limit {
		# # The most bytes a request's body may have.
		# # integer, 0 or more; required.
		# max_bytes 10485760
	# }

	# # Keeps responses by RFC 9111's rules, in memory and on disk, shared by the routes of a zone,
	# # and answers from them.
	# middleware cache {
		# # The store responses are kept in. Caches of the same zone, in one route or several, share it,
		# # its size and its keys; it is kept across reloads while a cache uses it. default when left
		# # out.
		# # string; default "default".
		# zone default

		# # The most bytes the zone keeps in memory, bodies, fields and keys counted; past it the least
		# # recently used responses go. 128 MiB when left out or 0. Caches of one zone take the size of
		# # the last one loaded.
		# # integer, 0 or more; default 134217728.
		# max_bytes 134217728

		# # The largest body kept; a larger response goes to its client without being kept. At most a
		# # sixteenth of max_bytes. 1 MiB when left out or 0.
		# # integer, 0 or more; default 1048576.
		# max_entry_bytes 1048576

		# # How long a response is fresh for when it gives no lifetime of its own (no s-maxage, max-age
		# # or Expires) and its status allows one to be assumed (200, 203, 300, 301, 308, 404, 405, 410,
		# # 414, 501): in place of a tenth of the time since its Last-Modified, at most a day, which is
		# # used when this is left out.
		# # duration, as "1.5s" or "2m".
		# default_ttl 10m

		# # Lets every request that misses fetch for itself. When left out, a request that misses while
		# # another fetches the same response waits for that fetch, up to lock_timeout, and is answered
		# # from what it keeps (a cache lock), so that many requests for a response not kept make one
		# # fetch.
		# # boolean.
		# disable_lock true

		# # How long a request waits for another's fetch of its response before it goes on to fetch for
		# # itself. 5s when left out.
		# # duration, as "1.5s" or "2m"; default "5s".
		# lock_timeout 5s

		# # How long past its lifetime a response may still be answered while the cache fetches it again
		# # in the background, for a response that does not say how long itself (Cache-Control
		# # stale-while-revalidate, RFC 5861). None when left out. A response that says must-revalidate,
		# # proxy-revalidate or s-maxage is never answered stale.
		# # duration, as "1.5s" or "2m".
		# stale_while_revalidate 1m

		# # How long past its lifetime a response may still be answered when fetching it again fails,
		# # with no response or a 500, 502, 503 or 504, for a response that does not say how long itself
		# # (Cache-Control stale-if-error, RFC 5861). None when left out.
		# # duration, as "1.5s" or "2m".
		# stale_if_error 1h

		# # A disk tier for the zone: every response kept in memory is written to disk too, on a pool of
		# # goroutines of its own, and one the memory no longer holds is read back from disk, on that
		# # pool, and kept in memory again. None when left out. Caches of one zone take the disk of the
		# # last one loaded.
		# # object.
		# disk {
			# # The directory the zone's responses are kept in, made if it is missing. It is the zone's
			# # alone: no other zone may name it. What it holds is found again when fit starts.
			# # string; required.
			# path /var/cache/fit

			# # The most bytes the zone keeps on disk; past it the least recently used responses go. 1 GiB
			# # when left out or 0.
			# # integer, 0 or more; default 1073741824.
			# max_bytes 1073741824

			# # The most responses the zone keeps on disk, which bounds the memory their index takes, a few
			# # hundred bytes each. 100000 when left out or 0.
			# # integer, 0 or more; default 100000.
			# max_entries 100000
		# }
	# }

	# # Stops sending a route's requests on while too many fail or are slow, then lets a few through
	# # to try again.
	# middleware circuit_breaker {
		# # How far back requests are counted, in ten steps; 10s when left out.
		# # duration, as "1.5s" or "2m"; default "10s".
		# window 10s

		# # How many requests the window must have counted before it can open; 20 when left out.
		# # integer, 1 or more; default 20.
		# min_requests 20

		# # The share of failures in the window that opens it; 0.5 when left out.
		# # number, 0 to 1; default 0.5.
		# error_ratio 0.5

		# # The statuses that count as failures; 500 to 599 when left out.
		# # list of integer.
		# statuses 502 503 504

		# # A response that takes longer than this to begin counts as slow; none is when left out.
		# # duration, as "1.5s" or "2m".
		# slow_threshold 2s

		# # With slow_threshold, the share of slow responses in the window that opens it; 0.5 when left
		# # out.
		# # number, 0 to 1; default 0.5.
		# slow_ratio 0.5

		# # How long it stays open before letting requests through to try; 30s when left out.
		# # duration, as "1.5s" or "2m"; default "30s".
		# open_duration 30s

		# # How many requests it lets through, half-open, that must all fare well for it to close; 5
		# # when left out. Others are answered 503 meanwhile.
		# # integer, 1 or more; default 5.
		# half_open_requests 5
	# }

	# # Asks for a client certificate, verified by the listener's TLS (mTLS), and passes its subject
	# # on.
	# middleware client_cert {
		# # Let a request without a certificate through as well, unauthenticated; refused with 403
		# # Forbidden when left out.
		# # boolean.
		# optional true

		# # A request field to set to the certificate's subject, as in "CN=alice,O=Example", for the
		# # handler and the upstream a proxy sends the request to; any the client sent is removed, with
		# # or without a certificate.
		# # string.
		# subject_header X-Client-Subject
	# }

	# # Compresses responses with zstd, brotli or gzip as they are written.
	# middleware compress {
		# # The encodings offered, the one the client prefers most chosen, and among those it prefers as
		# # much, the first here; zstd, br and gzip when left out.
		# # list of: zstd, br, gzip; default ["zstd","br","gzip"].
		# encodings zstd br gzip

		# # How hard the compressors work: fastest, default (gzip 5, zstd's default, brotli 4) or better
		# # (gzip 7, zstd's better, brotli 6); default when left out.
		# # one of: fastest, default, better; default "default".
		# level default

		# # The shortest declared body compressed; 1024 when left out. A body that declares no length,
		# # as one that streams, is compressed.
		# # integer, 0 or more; default 1024.
		# min_bytes 1024

		# # How many responses are compressed at once; past it, responses go uncompressed, so that the
		# # compressors' memory, a few hundred kilobytes each, is bounded. 1024 when left out.
		# # integer, 1 or more; default 1024.
		# max_in_flight 1024
	# }

	# # Limits how many of a route's requests are under way at once.
	# middleware concurrency_limit {
		# # The most requests under way at once.
		# # integer, 1 or more; required.
		# max 100

		# # The status of a request refused; 429 when left out, or 503 as nginx's limit_conn answers.
		# # integer; default 429.
		# status 429
	# }

	# # Asks an auth service whether a request may go on, and passes fields of its answer on.
	# middleware forward_auth {
		# # The name of the upstream the auth service is.
		# # string; required.
		# upstream app

		# # The path, and query, of the request sent to the auth service; / when left out.
		# # string; default "/".
		# uri /

		# # The request's fields sent to the auth service; all but the hop-by-hop ones and those of the
		# # body when left out.
		# # list of string.
		# request_headers Cookie Authorization

		# # Fields copied from a 2xx answer onto the request, for the handler and the upstream a proxy
		# # sends it to. Any of these the client sent are removed, so that it cannot pass them off as
		# # the auth service's.
		# # list of string.
		# copy_headers Remote-User Remote-Groups

		# # How long to wait for the auth service's answer, after which the request is answered 504
		# # Gateway Timeout; 10s when left out. A service that cannot be reached is answered 502 Bad
		# # Gateway.
		# # duration, as "1.5s" or "2m"; default "10s".
		# timeout 10s
	# }

	# # Sets, adds and deletes request and response header fields.
	# middleware headers {
		# # Changes to the request's fields, made before the handler, and the upstream a proxy sends the
		# # request to, sees them.
		# # object.
		# request {
			# # Fields to set, each replacing any of the same name.
			# # object of string.
			# set {
			# 	X-Env prod
			# }

			# # Values to add to fields, after any already there.
			# # object of list of string.
			# add {
			# 	Cache-Control no-store
			# }

			# # Fields to delete: names, or a prefix ending in "*", as in "X-Debug-*".
			# # list of string.
			# delete Server X-Debug-*
		# }

		# # Changes to the response's fields, made just before it is sent, whichever handler wrote it.
		# # object.
		# response {
			# # Fields to set, each replacing any of the same name.
			# # object of string.
			# set {
			# 	X-Env prod
			# }

			# # Values to add to fields, after any already there.
			# # object of list of string.
			# add {
			# 	Cache-Control no-store
			# }

			# # Fields to delete: names, or a prefix ending in "*", as in "X-Debug-*".
			# # list of string.
			# delete Server X-Debug-*
		# }
	# }

	# # Verifies JSON Web Tokens with keys from files, a secret or a JWK set, and passes claims on
	# # as fields.
	# middleware jwt {
		# # The URL of a JWK set (RFC 7517) whose signing keys tokens are verified with.
		# # string.
		# jwks_url https://auth.example.com/.well-known/jwks.json

		# # How often the JWK set is fetched again; 1h when left out. A token naming a kid the set does
		# # not have has it fetched sooner, at most every 10s.
		# # duration, as "1.5s" or "2m"; default "1h".
		# jwks_refresh_interval 1h

		# # PEM files of public keys or certificates (RSA, ECDSA or Ed25519) tokens are verified with.
		# # list of string.
		# public_key_files /etc/fit/jwt.pem

		# # A file whose contents are the secret of tokens signed with HS256, HS384 or HS512; at least
		# # 32 bytes.
		# # string.
		# hmac_secret_file /etc/fit/jwt-secret

		# # The algorithms tokens may be signed with; any that fits the keys when left out. none never
		# # is.
		# # list of: RS256, RS384, RS512, PS256, PS384, PS512, ES256, ES384, ES512, EdDSA, HS256, HS384, HS512.
		# algorithms RS256 RS384 RS512 PS256 PS384 PS512 ES256 ES384 ES512 EdDSA HS256 HS384 HS512

		# # The iss a token must have; any when left out.
		# # string.
		# issuer https://auth.example.com/

		# # Audiences of which a token's aud must name one; any when left out.
		# # list of string.
		# audience api

		# # How far exp and nbf may be off, for clocks that differ; none when left out.
		# # duration, as "1.5s" or "2m".
		# leeway 30s

		# # Where the token is: header, after Bearer in the Authorization field; header:Name, the whole
		# # of that field; cookie:name; or query:name. header when left out.
		# # string; default "header".
		# token_from header

		# # Request fields to set to claims, as {"X-User": "sub"}: a string as it is, anything else as
		# # JSON. Any of these fields the client sent are removed, with or without the claim.
		# # object of string.
		# claims_headers {
		# 	X-User sub
		# }
	# }

	# # Limits the rate of requests, by client address, header field or route, allowing a burst.
	# middleware rate_limit {
		# # How many requests a second each key may make, on average; at least 0.001.
		# # number; required.
		# rate 10

		# # How many requests a key may make at once, after it has been idle: the bucket's size. The
		# # rate, rounded up, when left out.
		# # integer, 0 or more.
		# burst 20

		# # What requests are counted by: ip, the client's address; route, every request of the route
		# # together; or header:Name, a header's value, with a request without it counted by ip. ip when
		# # left out.
		# # string; default "ip".
		# key ip

		# # The addresses ("10.0.0.1") and networks ("10.0.0.0/8") of proxies in front of fit: for a
		# # request that comes from one, the client's address is the last in X-Forwarded-For that is not
		# # one of them. None when left out, and the client is the connection's peer.
		# # list of string.
		# trusted_proxies 10.0.0.0/8

		# # The most keys kept at once, which bounds the memory the buckets take: under 100 bytes each,
		# # and up to 128 more for a header; 100000 when left out or 0.
		# # integer, 0 or more; default 100000.
		# max_keys 100000

		# # The status of a request refused; 429 when left out.
		# # integer; default 429.
		# status 429
	# }

	# # Redirects requests whose path a regular expression matches to a URL made from it.
	# middleware redirect {
		# # Where to: a URL or a path, in which {scheme}, {host} (with its port, as the client sent it),
		# # {path}, {query} (without the '?') and {uri} (the path and query) stand for the request's,
		# # and, with regexp, $1 or ${name} for its groups, as in "https://{host}{uri}" or "/new/$1".
		# # string; required.
		# to https://{host}{uri}

		# # The status: 301 and 308 are permanent, 302, 303 and 307 temporary; 307 and 308 keep the
		# # method and body. 302 when left out.
		# # integer; default 302.
		# status 302

		# # A regular expression in Go's syntax that the path must match for the request to be
		# # redirected; the rest go on to the handler. Every request is redirected when left out.
		# # string.
		# regexp ^/old/(.*)$
	# }

	# # Rewrites the request's path: strips or adds a prefix, or replaces what a regular expression
	# # matches.
	# middleware rewrite {
		# # Prefixes to take off the path: the first that the path starts with, at a segment boundary,
		# # is removed, and what is left starts with '/'. "/api" makes "/api/users" "/users" and "/api"
		# # "/", and leaves "/apix" alone.
		# # list of string.
		# strip_prefix /api

		# # A regular expression in Go's syntax; each match in the path is replaced with replacement.
		# # string.
		# regexp ^/old/(.*)$

		# # What replaces each match of regexp, in which $1 or ${name} stand for the regexp's groups.
		# # string.
		# replacement /new/$1

		# # A prefix put before the path, as in "/v2".
		# # string.
		# add_prefix /v2
	# }

	# # Runs a WebAssembly plugin, of fit's own interface or a Proxy-Wasm filter, on each request,
	# # on a pool of its own.
	# middleware wasm {
		# # The plugin: a WebAssembly module that exports fit_on_request, as a WASI reactor; package
		# # plugin/wasm/guest builds one from Go with GOOS=wasip1 GOARCH=wasm go build
		# # -buildmode=c-shared.
		# # string; required.
		# path /etc/fit/plugins/filter.wasm

		# # A string the plugin reads, for settings of its own.
		# # string.
		# config "{}"

		# # How many instances of the plugin run calls at once, each with its own memory: the CPUs fit
		# # has, at most 16, when left out or 0.
		# # integer, 0 or more.
		# instances 0

		# # How many requests may wait for an instance; past it a request is answered 503. 1024 when
		# # left out or 0.
		# # integer, 0 or more; default 1024.
		# queue 1024

		# # How long a call may run; past it the call is stopped and its instance replaced, and the
		# # request goes as a failure does (on_error). 100ms when left out.
		# # duration, as "1.5s" or "2m"; default "100ms".
		# timeout 100ms

		# # How long a request may wait for an instance; past it it is answered 503. 1s when left out.
		# # duration, as "1.5s" or "2m"; default "1s".
		# wait_timeout 1s

		# # The most memory an instance may have; one that asks for more fails its call. 128 MiB when
		# # left out or 0.
		# # integer, 0 or more; default 134217728.
		# max_memory_bytes 134217728

		# # For a Proxy-Wasm plugin, its VM configuration, which it reads as it starts; config is its
		# # plugin configuration.
		# # string.
		# vm_config "{}"

		# # For a Proxy-Wasm plugin, properties it reads by their path (proxy_get_property), beside the
		# # request's own: request.path, request.url_path, request.query, request.host, request.method,
		# # request.scheme, request.protocol, source.address and plugin_name.
		# # list of object.
		# properties {
			# # The property's path, by segment, as ["route_metadata", "filter_metadata",
			# # "envoy.filters.http.wasm", "auth"].
			# # list of string; required.
			# path plugin_name

			# # Its value.
			# # string.
			# value ...
		# }

		# # What a call that fails, traps or runs past its timeout leads to: fail answers 500, or fails
		# # a response under way, closing its HTTP/1 connection or resetting its stream; skip lets the
		# # request or its response go on as if the plugin were not there. fail when left out.
		# # one of: fail, skip; default "fail".
		# on_error fail

		# # For a Proxy-Wasm plugin that exports response callbacks, which it is given: all, the header,
		# # the body and the trailer; headers, the header alone, the body going by untouched; none, none
		# # of them, the plugin forgetting each request once it has gone on. all when left out.
		# # one of: all, headers, none; default "all".
		# response all

		# # For a Proxy-Wasm plugin that follows responses, how many an instance follows at once, each
		# # keeping its context; past it a request is answered 503. 1024 when left out or 0.
		# # integer, 0 or more; default 1024.
		# max_streams 1024

		# # For a Proxy-Wasm plugin given the response's body, how much of it the plugin may hold,
		# # pausing it to see more, or make it; past it the response fails, or goes on without the
		# # plugin when on_error is skip. 1 MiB when left out or 0.
		# # integer, 0 or more; default 1048576.
		# max_body_bytes 1048576
	# }

	# What answers the request.
	# module; required.
	# Answers with a fixed status, header fields and body.
	handler respond {
		# The status code; 200 when left out.
		# integer, 100 to 599; default 200.
		# status 200

		# Response headers. Content-Type defaults to text/plain; charset=utf-8 when there is a body.
		# object of string.
		# headers {
		# 	Cache-Control no-store
		# }

		# The response body.
		# string.
		body "hello from fit\n"
	}
}

# route {
	# # A route whose handler is fastcgi, with every one of its params.
	# name fastcgi-example
	# # Answers requests from a FastCGI application, as PHP-FPM is, over a bounded pool of
	# # connections, streaming both ways.
	# handler fastcgi {
		# # Where the application listens: a host and port, as "127.0.0.1:9000", or "unix/" and a
		# # socket's path, as "unix//run/php/php-fpm.sock".
		# # string; required.
		# address 127.0.0.1:9000

		# # The document root, which SCRIPT_FILENAME, DOCUMENT_ROOT and PATH_TRANSLATED are made from,
		# # as the application sees it.
		# # string; required.
		# root /srv/www

		# # What ends a script's name in a path, the rest being PATH_INFO: "/index.php/a/b" runs
		# # /index.php with PATH_INFO /a/b. [".php"] when left out.
		# # list of string; default [".php"].
		# split_path .php

		# # The script a path ending in / runs; index.php when left out.
		# # string; default "index.php".
		# index index.php

		# # Paths tried in turn, as nginx's try_files, for the script to run: {path} stands for the
		# # request's path, and the first whose script exists under root runs; ["{path}",
		# # "{path}/index.php", "/index.php"] sends what is no script of its own to the front
		# # controller, as most PHP applications want. Looked up on a pool of goroutines of its own.
		# # Left out, the path runs as it is.
		# # list of string.
		# try_files {path} {path}/index.php /index.php

		# # More parameters for the application, set after fit's own.
		# # object of string.
		# env {
		# 	APP_ENV prod
		# }

		# # The most connections to the application, each carrying one request at a time. 64 when left
		# # out or 0.
		# # integer, 0 or more; default 64.
		# max_conns 64

		# # The most idle connections kept for later requests. 16 when left out or 0.
		# # integer, 0 or more; default 16.
		# max_idle_conns 16

		# # How many requests may wait for a connection when max_conns are busy; past it a request is
		# # answered 503. 1024 when left out or 0.
		# # integer, 0 or more; default 1024.
		# max_pending 1024

		# # How long connecting may take; 5s when left out. A request that times out connecting is
		# # answered 504.
		# # duration, as "1.5s" or "2m"; default "5s".
		# connect_timeout 5s

		# # How long the application may take to begin its response; 60s when left out.
		# # duration, as "1.5s" or "2m"; default "60s".
		# response_header_timeout 60s

		# # How long the application may go silent in the middle of a response; 60s when left out.
		# # duration, as "1.5s" or "2m"; default "60s".
		# response_idle_timeout 60s

		# # The most a whole exchange may take; 10m when left out.
		# # duration, as "1.5s" or "2m"; default "10m".
		# timeout 10m

		# # How long an idle connection is kept; 60s when left out.
		# # duration, as "1.5s" or "2m"; default "60s".
		# idle_timeout 60s

		# # The most bytes the response's CGI header may take; past it the request is answered 502. 64
		# # KiB when left out or 0.
		# # integer, 0 or more; default 65536.
		# max_header_bytes 65536
	# }
# }

# route {
	# # A route whose handler is forward_proxy, with every one of its params.
	# name forward_proxy-example
	# # A forward proxy for HTTP CONNECT, with access rules for clients and destinations.
	# handler forward_proxy {
		# # The addresses and CIDR ranges of the clients that may use the proxy, as "10.0.0.0/8"; others
		# # are answered 403.
		# # list of string; required.
		# clients 10.0.0.0/8

		# # The destinations the proxy connects to: host names, "*.example.com" for every name below
		# # example.com, IP addresses and CIDR ranges, which also hold the address a host name resolves
		# # to. Every destination deny does not hold when left out; others are answered 403, or 502 for
		# # a host name whose address decides.
		# # list of string.
		# allow *.example.com 10.1.0.0/16

		# # Destinations refused, written as in allow, whatever allow holds.
		# # list of string.
		# deny 169.254.169.254

		# # The destination ports allowed; any when left out.
		# # list of integer.
		# ports 443

		# # How long resolving and connecting to a destination may take; past it the request is answered
		# # 504. 10s when left out.
		# # duration, as "1.5s" or "2m"; default "10s".
		# connect_timeout 10s

		# # How long a tunnel may carry nothing either way before it and its connection to the
		# # destination are closed. 5m when left out.
		# # duration, as "1.5s" or "2m"; default "5m".
		# idle_timeout 5m
	# }
# }

# route {
	# # A route whose handler is proxy, with every one of its params.
	# name proxy-example
	# # Proxies requests to an upstream, or to several by weight, with retries, mirroring and
	# # failover; WebSockets and gRPC calls too, streamed both ways.
	# handler proxy {
		# # The name of the upstream requests go to; or upstreams.
		# # string.
		# upstream app

		# # Upstreams requests are spread over at random by weight, as a canary release does, in place
		# # of upstream.
		# # list of object.
		# upstreams {
			# # The name of the upstream.
			# # string; required.
			# upstream app-canary

			# # Its share of the requests, against the others' weights.
			# # integer, 1 to 1000; required.
			# weight 5
		# }

		# # An upstream that takes the requests when none of the chosen upstream's backends is in
		# # rotation, for failing or for its health checks, and one of its own is.
		# # string.
		# failover app-backup

		# # Send a copy of a share of the requests whose bodies arrive whole (64KB at most) to another
		# # upstream, and drop its answers. At most 256 copies are under way at once; past that,
		# # requests are not copied. The requests themselves do not wait for their copies.
		# # object.
		# mirror {
			# # The name of the upstream the copies go to.
			# # string; required.
			# upstream shadow

			# # The share of requests copied, chosen at random; all of them when left out.
			# # number, 0 to 100; default 100.
			# percent 100
		# }

		# # The addresses ("10.0.0.1") and networks ("10.0.0.0/8") of proxies in front of this one,
		# # whose X-Forwarded-* and Forwarded fields are believed. None when left out.
		# # list of string.
		# trusted_proxies 10.0.0.0/8

		# # The Host header sent upstream; the client's when left out.
		# # string.
		# host_header app.internal

		# # Send a request that failed again, to the backend the upstream picks next: one whose
		# # connection could not be made, whatever its method, and, for GET, HEAD, OPTIONS, TRACE, PUT
		# # and DELETE, one that failed before its response began or was answered with a status of
		# # statuses. A request whose body streams (past 64KB, or still arriving) is never sent again.
		# # No retries when left out.
		# # object.
		# retry {
			# # How many times a request may be sent again after the first; 2 when left out.
			# # integer, 1 to 10; default 2.
			# attempts 2

			# # Statuses of the upstream's, 5xx ones, that have a request of an idempotent method sent
			# # again, as 502, 503 and 504; none when left out, so that only requests that got no response
			# # are.
			# # list of integer.
			# statuses 502 503 504

			# # Retries may add at most this share of the requests the proxy takes, so that retries cannot
			# # multiply the load on an upstream already failing; 0.2 when left out.
			# # number, 0 to 1; default 0.2.
			# budget_ratio 0.2

			# # Retries allowed each second beyond budget_ratio, so that a proxy taking few requests may
			# # still retry; 10 when left out.
			# # number, 0 or more; default 10.
			# budget_min_per_second 10
		# }

		# # How long a tunnel, as a WebSocket the proxy has joined to its upstream is, may carry nothing
		# # either way before it is closed; 10m when left out.
		# # duration, as "1.5s" or "2m"; default "10m".
		# tunnel_idle_timeout 10m

		# # The most a request may take, from when the proxy takes it to the end of its response,
		# # retries included: one past it before its response began is answered 504, and one whose
		# # response is under way is cut short. None when left out.
		# # duration, as "1.5s" or "2m".
		# timeout 30s
	# }
# }

# route {
	# # A route whose handler is static, with every one of its params.
	# name static-example
	# # Serves files from a directory, with directory listings, precompressed variants and small
	# # files kept in memory.
	# handler static {
		# # The directory files are served from.
		# # string; required.
		# root /srv/www

		# # The files that stand for a directory, tried in order; ["index.html"] when left out, and none
		# # for [].
		# # list of string; default ["index.html"].
		# index index.html

		# # A prefix removed from the request path before it is looked up under the root; a request
		# # whose path lacks it gets 404.
		# # string.
		# strip_prefix /api

		# # The largest file kept in memory, in bytes; 1 MiB when left out.
		# # integer, 0 or more; default 1048576.
		# max_file_bytes 1048576

		# # How many bytes of files are kept in memory at most; 64 MiB when left out.
		# # integer, 0 or more; default 67108864.
		# max_cache_bytes 67108864

		# # Encodings whose compressed twins, name.br, name.zst and name.gz, are served in place of a
		# # file to a client that accepts them: the one it prefers by Accept-Encoding, and among equals
		# # the first listed. None when left out.
		# # list of: br, zstd, gzip.
		# precompressed br zstd gzip

		# # Paths tried in turn for a request, as nginx's try_files: {path} stands for the request's
		# # path, and one ending in / for a directory, served by its index file. The first that exists
		# # is served, and when none does the answer is 404; ["{path}", "{path}/", "/index.html"] serves
		# # a single-page app. A directory asked for without its slash is not redirected then.
		# # list of string.
		# try_files {path} {path}/ /index.html

		# # List a directory that has no index file, rather than answering 404. Files whose names start
		# # with a dot are left out.
		# # boolean.
		# browse true

		# # The most entries a listing reads and shows; a directory with more is listed in part, and
		# # says so. 10000 when left out or 0.
		# # integer, 0 or more; default 10000.
		# browse_max_entries 10000

		# # How long what the handler learned of a request path, the file it names and its validators,
		# # is trusted before the disk is looked at again; a change on disk shows within it. 1s when
		# # left out.
		# # duration, as "1.5s" or "2m"; default "1s".
		# check_interval 1s
	# }
# }
