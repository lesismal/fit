// fit's config template: every field of the config and of every module's params.
// Generated by schema.Template; regenerate with: go test ./schema -update
//
// What is written out is a small config fit runs as it is: a listener on :8080, an
// upstream, and a route answering "hello from fit". Every other field is commented
// out, with its default, or an example where it has none: uncomment what you need.
// Above each field: what it is, its type, its choices and its default. A field left out
// takes its default. The config reference, docs/reference/config.md, has the same, with
// examples; the templates in the other formats are beside this one's directory.
{
  // The version of fit's config this one is written for, 1; fit refuses a config written for a
  // version it does not read, rather than read it wrongly. Optional: a config that leaves it out
  // is read as version 1.
  // integer, 1.
  "schema_version": 1,

  // The addresses fit listens on, and the protocols each one serves. When left out, HTTPS by
  // default makes them from the routes' host names; see auto_https.
  // list of object.
  "listeners": [
    {
      // A name unique among the listeners, by which routes refer to this one.
      // string; required.
      "name": "web",

      // The host and port to listen on, as in ":8080" or "127.0.0.1:8080".
      // string; required.
      "address": ":8080",

      // The protocols served: http/1.1, h2c (HTTP/2 in the clear) and, with tls, h2 (HTTP/2 over
      // TLS, chosen through ALPN) and h3 (HTTP/3 over QUIC, on the same port in UDP, announced to
      // HTTP/1 and HTTP/2 clients with Alt-Svc); tcp, raw TCP, whose connections the services that
      // list the listener proxy to their upstreams; socks, a SOCKS5 and SOCKS4 forward proxy, as
      // socks says; or udp alone, whose datagrams a service proxies. A listener that serves more
      // than one of HTTP, tcp and socks tells them apart on its port by what a client sends first: a
      // TLS ClientHello goes to the service whose server_names hold its name, or else, with tls, is
      // served HTTPS, or else goes to the service without server_names; a SOCKS greeting to socks;
      // an HTTP request, in the clear, to HTTP; and whatever else to the service without
      // server_names, or it is closed. A client that waits for the server to speak first is closed
      // after 10s: such a protocol needs a listener of its own. http/1.1 alone when left out, or
      // http/1.1 and h2 with tls.
      // list of: http/1.1, h2c, h2, h3, tcp, udp, socks.
      "protocols": ["http/1.1", "h2c"],

      // Serve TLS, with these certificates: the listener's HTTP is HTTPS.
      // object.
      // "tls": {
        // // Certificates from files. A client is given the first whose names match the one it asks for,
        // // or the first of all when none does or it asks for none.
        // // list of object.
        // "certificates": [
          // {
            // // A PEM file with the certificate, followed by any intermediates.
            // // string; required.
            // "cert_file": "/etc/fit/example.com.pem",

            // // A PEM file with the certificate's private key.
            // // string; required.
            // "key_file": "/etc/fit/example.com.key",
          // },
        // ],

        // // Host names to obtain certificates for with ACME, as the top-level acme says, through its
        // // challenges: the CA must reach fit at each name on port 80, where any listener of fit's in
        // // the clear answers HTTP-01, or on port 443, where this listener answers TLS-ALPN-01. A client
        // // asking for one of these names is given its certificate once there is one; until then, and
        // // for other names, the certificates from files.
        // // list of string.
        // "acme": ["example.com", "www.example.com"],

        // // Obtain a certificate during the handshake for a name a client asks for that neither the
        // // files nor acme have, as the top-level acme.on_demand allows; needs it.
        // // boolean.
        // "on_demand": true,

        // // Ask clients for certificates and verify them (mutual TLS).
        // // object.
        // "client_auth": {
          // // PEM files of the certificate authorities a client's certificate must chain to. They are
          // // watched as certificate files are: a change loads the config again.
          // // list of string; required.
          // "ca_files": ["/etc/fit/clients-ca.pem"],

          // // require: a client without a valid certificate is refused in the handshake; verify_if_given:
          // // a client may send none, and a route that needs one says so with the client_cert middleware,
