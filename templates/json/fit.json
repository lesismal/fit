// fit's config template: every field of the config and of every module's params.
// Generated by schema.Template; regenerate with: go test ./schema -update
//
// What is written out is a small config fit runs as it is: a listener on :8080, an
// upstream, and a route answering "hello from fit". Every other field is commented
// out, with its default, or an example where it has none: uncomment what you need.
// Above each field: what it is, its type, its choices and its default. A field left out
// takes its default. The config reference, docs/reference/config.md, has the same, with
// examples; the templates in the other formats are beside this one's directory.
{
  // The version of fit's config this one is written for, 1; fit refuses a config written for a
  // version it does not read, rather than read it wrongly. Optional: a config that leaves it out
  // is read as version 1.
  // integer, 1; default 1.
  "schema_version": 1,

  // The addresses fit listens on, and the protocols each one serves. When left out, HTTPS by
  // default makes them from the routes' host names; see auto_https.
  // list of object.
  "listeners": [
    {
      // A name unique among the listeners, by which routes refer to this one.
      // string; required.
      "name": "web",

      // The host and port to listen on, as in ":8080" or "127.0.0.1:8080".
      // string; required.
      "address": ":8080",

      // The protocols served: http/1.1, h2c (HTTP/2 in the clear) and, with tls, h2 (HTTP/2 over
      // TLS, chosen through ALPN) and h3 (HTTP/3 over QUIC, on the same port in UDP, announced to
      // HTTP/1 and HTTP/2 clients with Alt-Svc); tcp, raw TCP, whose connections the services that
      // list the listener proxy to their upstreams; socks, a SOCKS5 and SOCKS4 forward proxy, as
      // socks says; or udp alone, whose datagrams a service proxies. A listener that serves more
      // than one of HTTP, tcp and socks tells them apart on its port by what a client sends first: a
      // TLS ClientHello goes to the service whose server_names hold its name, or else, with tls, is
      // served HTTPS, or else goes to the service without server_names; a SOCKS greeting to socks;
      // an HTTP request, in the clear, to HTTP; and whatever else to the service without
      // server_names, or it is closed. A client that waits for the server to speak first is closed
      // after 10s: such a protocol needs a listener of its own. http/1.1 alone when left out, or
      // http/1.1 and h2 with tls.
      // list of: http/1.1, h2c, h2, h3, tcp, udp, socks.
      "protocols": ["http/1.1", "h2c"],

      // Listen the listener's TCP connections with Multipath TCP where the kernel offers it (Linux
      // 5.6+, net.mptcp.enabled), falling back to plain TCP where it does not; a client without
      // Multipath TCP falls back too. Off by default: a listener is plain TCP. udp listeners and
      // HTTP/3 take none.
      // boolean.
      // "mptcp": true,

      // Serve TLS, with these certificates: the listener's HTTP is HTTPS.
      // object.
      // "tls": {
        // // Certificates from files. A client is given the first whose names match the one it asks for,
        // // or the first of all when none does or it asks for none.
        // // list of object.
        // "certificates": [
          // {
            // // A PEM file with the certificate, followed by any intermediates.
            // // string; required.
            // "cert_file": "/etc/fit/example.com.pem",

            // // A PEM file with the certificate's private key.
            // // string; required.
            // "key_file": "/etc/fit/example.com.key",
          // },
        // ],

        // // Host names to obtain certificates for with ACME, as the top-level acme says, through its
        // // challenges: the CA must reach fit at each name on port 80, where any listener of fit's in
        // // the clear answers HTTP-01, or on port 443, where this listener answers TLS-ALPN-01. A client
        // // asking for one of these names is given its certificate once there is one; until then, and
        // // for other names, the certificates from files.
        // // list of string.
        // "acme": ["example.com", "www.example.com"],

        // // Obtain a certificate during the handshake for a name a client asks for that neither the
        // // files nor acme have, as the top-level acme.on_demand allows; needs it.
        // // boolean.
        // "on_demand": true,

        // // Ask clients for certificates and verify them (mutual TLS).
        // // object.
        // "client_auth": {
          // // PEM files of the certificate authorities a client's certificate must chain to. They are
          // // watched as certificate files are: a change loads the config again.
          // // list of string; required.
          // "ca_files": ["/etc/fit/clients-ca.pem"],

          // // require: a client without a valid certificate is refused in the handshake; verify_if_given:
          // // a client may send none, and a route that needs one says so with the client_cert middleware,
          // // but one it sends must be valid. require when left out. A listener that requires certificates
          // // cannot answer ACME's TLS-ALPN-01 challenge, whose CA sends none.
          // // one of: require, verify_if_given; default "require".
          // "mode": "require",
        // },
      // },

      // Who may use the listener's socks, and where it connects them: needed with socks. It serves
      // CONNECT, without authentication, and refuses BIND and UDP ASSOCIATE.
      // object.
      // "socks": {
        // // The addresses and CIDR ranges of the clients that may use the proxy, as "10.0.0.0/8"; others
        // // are refused.
        // // list of string; required.
        // "clients": ["10.0.0.0/8"],

        // // The destinations the proxy connects to: host names, "*.example.com" for every name below
        // // example.com, IP addresses and CIDR ranges, which also hold the address a host name resolves
        // // to. Every destination deny does not hold when left out, but for loopback, link-local
        // // (169.254.169.254, the metadata service of most clouds, among them), unspecified and
        // // multicast addresses and the host's own, which are refused unless a range here lies inside
        // // theirs, as "127.0.0.0/8" does and "0.0.0.0/0" does not, or, for the host's own, names that
        // // address alone.
        // // list of string.
        // "allow": ["*.example.com", "10.1.0.0/16"],

        // // Destinations refused, written as in allow, whatever allow holds: a host name that resolves
        // // to an address deny holds is refused once it is connected, before anything is sent.
        // // list of string.
        // "deny": ["169.254.169.254"],

        // // The destination ports allowed; any when left out.
        // // list of integer.
        // "ports": [443],

        // // How long resolving and connecting to a destination may take. 10s when left out.
        // // duration, as "1.5s" or "2m"; default "10s".
        // "connect_timeout": "10s",

        // // How long a proxied connection may carry nothing either way before both sides are closed. 5m
        // // when left out.
        // // duration, as "1.5s" or "2m"; default "5m".
        // "idle_timeout": "5m",
      // },

      // The client addresses the listener serves, deciding before the global access: a connection it
      // refuses is closed as soon as it is accepted, or, for HTTP/3 and udp, its datagrams dropped,
      // unless a route or service of the listener sets an access of its own, which then decides
      // first, for its requests or connections. With proxy_protocol the address is the one the
      // header names.
      // object.
      // "access": {
        // // IP addresses and CIDR prefixes served, as "10.0.0.0/8" or "2001:db8::/32": with any entry
        // // here or in allow_files, every address neither holds is refused, unless deny refuses it
        // // first.
        // // list of string.
        // "allow": ["10.0.0.0/8", "192.168.0.0/16"],

        // // IP addresses and CIDR prefixes refused, whatever allow holds.
        // // list of string.
        // "deny": ["203.0.113.0/24"],

        // // Files of more allow entries, one on each line, each line told apart by its content: an
        // // address or prefix, with what follows # or ; left out, as the lists published for firewalls
        // // are written; a range, first-last; an eMule ipfilter.dat line, first - last , level , name,
        // // where a level above 127 is not listed; or a PeerGuardian .p2p line, name:first-last. IPv4
        // // addresses of ranges may have leading zeros. Blank lines and lines that begin with #, ; or //
        // // are left out; any other line is an error. Read when the config is applied, and applied again
        // // when one changes; each at most 64 MiB.
        // // list of string.
        // "allow_files": [],

        // // Files of more deny entries, written as allow_files.
        // // list of string.
        // "deny_files": [],
      // },

      // Take a PROXY protocol header, of version 1 or 2, at the start of each connection from a
      // trusted address, and serve the connection as from the client it names. For listeners of tcp
      // and of HTTP over TCP; with tls the header comes before TLS. HTTP/3 takes none.
      // object.
      // "proxy_protocol": {
        // // The addresses and CIDR ranges of the proxies that send the header, as "10.0.0.0/8": a
        // // connection from one of them must begin with a header, within 10s, or it is closed, and one
        // // from elsewhere is served as it is, with no header.
        // // list of string; required.
        // "trusted": ["10.0.0.0/8"],
      // },
    },
  ],

