// fit's config template as a directory: every field of the config and of every module's
// params, in files by kind. Generated by schema.TemplateDir; regenerate with:
// go test ./schema -update
//
// fit run -c <this directory> reads every file in it, its subdirectories too, in lexical
// order. listeners, routes, upstreams, services and providers are joined across the files;
// any other field is written in one file only. What is written out runs as it is: a
// listener on :8080, example.com answering "hello from fit", and api.example.com proxied
// to 127.0.0.1:9000. Every other field is commented out, with its default or an example:
// uncomment what you need. docs/reference/config.md describes them all.
//
// This file:
// A site: the routes of api.example.com, proxied to its upstream, which is here with
// every field of an upstream (balancing, limits, timeouts, health checks). Copy this
// file for each site, one file a site; upstream names are shared by every file.
{
  // How requests are matched, and what handles them.
  // list of object.
  "routes": [
    {
      // A name unique among the routes, for logs and metrics.
      // string.
      "name": "api",

      // The names of the listeners the route serves; every listener when left out.
      // list of string.
      // "listeners": ["web"],

      // Routes with a higher priority are picked first; among equal ones, the most specific host,
      // then path, then the one with the most other matchers set (method, header, query, remote_ip,
      // path_regexp, expr), then the one written first.
      // integer.
      // "priority": 10,

      // What a request must match; every request when left out.
      // object.
      "match": {
        // Host names, exact, or with a leading "*." wildcard, which stands for one label, or a leading
        // "**." wildcard, which stands for one label or more, as the Gateway API's wildcards do.
        // list of string.
        "host": ["api.example.com"],

        // Paths, exact or ending in "*" to match a prefix.
        // list of string.
        // "path": ["/api/*"],

        // Regular expressions in Go's syntax, matched against the path anywhere in it unless anchored
        // with ^ and $.
        // list of string.
        // "path_regexp": ["^/v[0-9]+/"],

        // Methods, as in "GET"; compared as written, since methods are case-sensitive.
        // list of string.
        // "method": ["GET", "POST"],

        // Headers the request must have, each with one of the values listed as the value of one of its
        // fields, or with any value when none are listed. Names ignore case; values do not.
        // object of list of string.
        // "header": {"X-Env": ["prod"]},

        // Query parameters the request must have, each with one of the values listed, or with any
        // value when none are listed; compared once unescaped.
        // object of list of string.
        // "query": {"debug": []},

        // IP addresses and CIDR prefixes, as in "10.0.0.0/8", the client's address must be in: the
        // address of the connection, not of X-Forwarded-For.
        // list of string.
        // "remote_ip": ["10.0.0.0/8"],

        // An expression the request must match, combining matchers with &&, ||, ! and parentheses, as
        // in Host("a.example") && (PathPrefix("/api/") || Method("POST")). Its matchers are Host,
        // Path, PathPrefix, PathRegexp, Method, Header(name, value...), Query(key, value...) and
        // RemoteIP, whose arguments are strings quoted as in Go. It counts as one matcher in the order
        // of routes, and its hosts and paths do not make a route more specific: give it a priority.
        // string.
        // "expr": "Host(\"example.com\") && (PathPrefix(\"/api/\") || Method(\"POST\"))",
      },

      // Middleware a request passes through, in order, before the handler.
      // list of module.
      // "middleware": [
      // ],

      // What answers the request.
      // module; required.
      "handler": {
        // Proxies requests to an upstream, or to several by weight, with retries, mirroring and
        // failover; WebSockets and gRPC calls too, streamed both ways.
        "module": "proxy",
        "params": {
          // The name of the upstream requests go to; or upstreams.
          // string.
          "upstream": "api",

          // Upstreams requests are spread over at random by weight, as a canary release does, in place
          // of upstream.
          // list of object.
          // "upstreams": [
            // {
              // // The name of the upstream.
              // // string; required.
              // "upstream": "app-canary",

              // // Its share of the requests, against the others' weights.
              // // integer, 1 to 1000; required.
              // "weight": 5,
            // },
          // ],

          // An upstream that takes the requests when none of the chosen upstream's backends is in
          // rotation, for failing or for its health checks, and one of its own is.
          // string.
          // "failover": "app-backup",

          // Send a copy of a share of the requests whose bodies arrive whole (64KB at most) to another
          // upstream, and drop its answers. At most 256 copies are under way at once; past that,
          // requests are not copied. The requests themselves do not wait for their copies.
          // object.
          // "mirror": {
            // // The name of the upstream the copies go to.
            // // string; required.
            // "upstream": "shadow",

            // // The share of requests copied, chosen at random; all of them when left out.
            // // number, 0 to 100; default 100.
            // "percent": 100,
          // },

          // The addresses ("10.0.0.1") and networks ("10.0.0.0/8") of proxies in front of this one,
          // whose X-Forwarded-* and Forwarded fields are believed. None when left out.
          // list of string.
          // "trusted_proxies": ["10.0.0.0/8"],

          // The Host header sent upstream; the client's when left out.
          // string.
          // "host_header": "app.internal",

          // Send a request that failed again, to the backend the upstream picks next: one whose
          // connection could not be made, whatever its method, and, for GET, HEAD, OPTIONS, TRACE, PUT
          // and DELETE, one that failed before its response began or was answered with a status of
          // statuses. A request whose body streams (past 64KB, or still arriving) is never sent again.
          // No retries when left out.
          // object.
          // "retry": {
            // // How many times a request may be sent again after the first; 2 when left out.
            // // integer, 1 to 10; default 2.
            // "attempts": 2,

            // // Statuses of the upstream's, 5xx ones, that have a request of an idempotent method sent
            // // again, as 502, 503 and 504; none when left out, so that only requests that got no response
            // // are.
            // // list of integer.
            // "statuses": [502, 503, 504],

            // // Retries may add at most this share of the requests the proxy takes, so that retries cannot
            // // multiply the load on an upstream already failing; 0.2 when left out.
            // // number, 0 to 1; default 0.2.
            // "budget_ratio": 0.2,

            // // Retries allowed each second beyond budget_ratio, so that a proxy taking few requests may
            // // still retry; 10 when left out.
            // // number, 0 or more; default 10.
            // "budget_min_per_second": 10,
          // },

          // How long a tunnel, as a WebSocket the proxy has joined to its upstream is, may carry nothing
          // either way before it is closed; 10m when left out.
          // duration, as "1.5s" or "2m"; default "10m".
          // "tunnel_idle_timeout": "10m",

          // The most a request may take, from when the proxy takes it to the end of its response,
          // retries included: one past it before its response began is answered 504, and one whose
          // response is under way is cut short. None when left out.
          // duration, as "1.5s" or "2m".
          // "timeout": "30s",
        },
      },
    },
  ],

  // The servers requests can be proxied to, by name.
  // list of object.
  "upstreams": [
    {
      // A name unique among the upstreams, by which handlers refer to this one.
      // string; required.
      "name": "api",

      // The addresses of the upstream's servers, each a host and a port, as in "10.0.0.1:8080" or
      // "backend:80".
      // list of string; required.
      "addresses": ["127.0.0.1:9000"],

      // Each address's weight, in the order of addresses: its share of requests under
      // weighted_round_robin, and how many requests it takes to be as busy as an address of weight 1
      // under least_conn. 1 each when left out.
      // list of integer.
      // "weights": [3, 1],

      // How requests are spread over the addresses: round_robin, in turn; weighted_round_robin, in
      // turn by weight (smoothly, as nginx does); least_conn, to the address with the fewest
      // requests under way for its weight; random, at random by weight; p2c, to the less busy for
      // its weight of two addresses chosen at random; ip_hash, uri_hash, header_hash and
      // cookie_hash, by a consistent hash of the client's IP address, the request's path and query,
      // the header hash_key names or the cookie it names, so that the same key goes to the same
      // address while it is up, and adding or removing an address moves only the keys that went to
      // it or will. A request without the header or cookie goes in turn. round_robin when left out,
      // or weighted_round_robin when weights are given.
      // one of: round_robin, weighted_round_robin, least_conn, random, p2c, ip_hash, uri_hash, header_hash, cookie_hash.
      // "load_balancing": "round_robin",

      // With header_hash, the header, and with cookie_hash, the cookie, whose value requests are
      // hashed by.
      // string.
      // "hash_key": "X-User",

      // Keep each client on one address with a cookie: a request whose cookie names an address that
      // is up goes there, and any other gets the cookie for the address it went to. No cookie when
      // left out.
      // object.
      // "sticky_cookie": {
        // // The cookie's name; fit_sticky when left out.
        // // string; default "fit_sticky".
        // "name": "fit_sticky",

        // // The cookie's Path; / when left out.
        // // string; default "/".
        // "path": "/",

        // // How long the client keeps the cookie, as its Max-Age; until the browser closes when left
        // // out.
        // // duration, as "1.5s" or "2m".
        // "max_age": "24h",

        // // Mark the cookie Secure, so that it is sent only over HTTPS. It is always HttpOnly and
        // // SameSite=Lax.
        // // boolean.
        // "secure": true,
      // },

      // The most connections open, or being opened, to one address; a request past it waits for one
      // to be free. 256 when left out or 0.
      // integer, 0 or more; default 256.
      // "max_conns": 256,

      // How many requests may wait for a connection to one address once its max_conns are busy; one
      // past it is answered 503 at once. 1024 when left out or 0.
      // integer, 0 or more; default 1024.
      // "max_pending": 1024,

      // How many idle connections to one address are kept for later requests; 32 when left out, and
      // 0 keeps none.
      // integer, 0 or more; default 32.
      // "max_idle_conns": 32,

      // How long an idle connection is kept before it is closed; 60s when left out.
      // duration, as "1.5s" or "2m"; default "60s".
      // "idle_timeout": "60s",

      // How long opening a connection may take; 10s when left out. A request whose connect times out
      // gets 504.
      // duration, as "1.5s" or "2m"; default "10s".
      // "connect_timeout": "10s",

      // How requests reach the upstream: http/1.1 in the clear, h2c (HTTP/2 in the clear, which the
      // servers must expect), or h2 (TLS, with HTTP/2 when the server chooses it through ALPN and
      // HTTP/1.1 otherwise). http/1.1 when left out.
      // one of: http/1.1, h2c, h2; default "http/1.1".
      // "protocol": "http/1.1",

      // With h2: the name the servers' certificates are checked against, and sent in SNI; each
      // address's host when left out.
      // string.
      // "tls_server_name": "app.internal",

      // With h2: a PEM file of the certificates the servers' are checked against, in place of the
      // system's roots. It is watched, as a listener's certificate files are: a change loads the
      // config again.
      // string.
      // "tls_ca_file": "/etc/fit/upstream-ca.pem",

      // With h2: a PEM file of the client certificate, and the chain after it, that fit presents to
      // servers that ask for one (mutual TLS); needs tls_key_file. It is watched, as tls_ca_file is:
      // a change loads the config again.
      // string.
      // "tls_cert_file": "/etc/fit/client.pem",

      // With h2: the PEM file of tls_cert_file's private key.
      // string.
      // "tls_key_file": "/etc/fit/client.key",

      // How many failed requests to an address within fail_timeout take it out of rotation for
      // fail_timeout, as nginx's max_fails does: a connect that failed, an upstream that broke off
      // or timed out. 1 when left out; 0 keeps every address in rotation.
      // integer, 0 or more; default 1.
      // "max_fails": 1,

      // The window max_fails are counted in, and how long an address that reached them stays out;
      // 10s when left out.
      // duration, as "1.5s" or "2m"; default "10s".
      // "fail_timeout": "10s",

      // How long the upstream may take, once the request is sent, to begin its response; 60s when
      // left out. A request past it gets 504.
      // duration, as "1.5s" or "2m"; default "60s".
      // "response_header_timeout": "60s",

      // How long the upstream may go silent in the middle of a response body; 60s when left out.
      // duration, as "1.5s" or "2m"; default "60s".
      // "response_idle_timeout": "60s",

      // How long a whole response may take, from sending the request to the end of its body; 1h when
      // left out. A request past it before its response began gets 504, and one past it later is cut
      // short.
      // duration, as "1.5s" or "2m"; default "1h".
      // "response_timeout": "1h",

      // Probe each address on a schedule, and take one that fails its probes out of rotation until
      // it passes them again; no probes when left out. Probes and max_fails take an address out each
      // on their own account.
      // object.
      // "health_check": {
        // // http sends a GET request, over the upstream's protocol, and passes on an expected status;
        // // tcp passes once a connection opens. http when left out.
        // // one of: http, tcp; default "http".
        // "type": "http",

        // // With http: the path, and query, the probe asks for; / when left out.
        // // string; default "/".
        // "path": "/",

        // // With http: the Host field the probe sends; the address's host when left out.
        // // string.
        // "host": "app.internal",

        // // The port probes go to, in place of each address's own.
        // // integer, 1 to 65535.
        // "port": 8081,

        // // With http: the statuses that pass; any from 200 to 399 when left out.
        // // list of integer.
        // "expect_status": [200, 204],

        // // How long from the start of one probe of an address to the start of the next; 5s when left
        // // out.
        // // duration, as "1.5s" or "2m"; default "5s".
        // "interval": "5s",

        // // How long a probe may take, connecting included, before it fails; 2s when left out. No longer
        // // than interval.
        // // duration, as "1.5s" or "2m"; default "2s".
        // "timeout": "2s",

        // // Up to how much longer than interval each wait between probes may be, chosen at random each
        // // time, so that probes from many upstreams spread out; a tenth of interval when left out. Less
        // // than interval.
        // // duration, as "1.5s" or "2m".
        // "jitter": "10s",

        // // How many probes in a row must fail to take an address out of rotation; 2 when left out or 0.
        // // integer, 0 or more; default 2.
        // "fails": 2,

        // // How many probes in a row must pass to put an address that was out back in; 2 when left out
        // // or 0.
        // // integer, 0 or more; default 2.
        // "passes": 2,
      // },
    },
  ],
}
