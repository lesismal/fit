        // // integer, 0 or more; default 1000.
        // "max_keys": 1000,

        // // How often the keys are read again whether or not a watch event came. 30s when left out.
        // // duration, as "1.5s" or "2m"; default "30s".
        // "refresh_interval": "30s",

        // // How long each request to etcd may take, connecting included, and a watch to start; a watch
        // // then lasts until it fails. 10s when left out.
        // // duration, as "1.5s" or "2m"; default "10s".
        // "request_timeout": "10s",
