      // // Listeners, routes, services and upstreams from a Kubernetes cluster's Gateway API resources:
      // // the Gateways of the GatewayClasses whose controllerName is fit's, and their HTTPRoutes,
      // // GRPCRoutes, TLSRoutes, TCPRoutes and UDPRoutes, whose status fit writes back.
      // // object.
      // "kubernetes": {
        // // A kubeconfig file to reach the cluster with: its server, CA, client certificate, token or
        // // token file. When left out, the pod's service account, inside the cluster, or else
        // // $KUBECONFIG or ~/.kube/config. Exec and auth-provider plugins are not supported.
        // // string.
        // "kubeconfig": "/etc/fit/kubeconfig",

        // // The kubeconfig's context to use; its current-context when left out.
        // // string.
        // "context": "prod",

        // // The controllerName of the GatewayClasses whose Gateways fit serves. lesismal.github.io/fit
        // // when left out.
        // // string; default "lesismal.github.io/fit".
        // "controller_name": "lesismal.github.io/fit",

        // // The namespaces whose Gateways and routes are served; every namespace when left out.
        // // Resources are watched across the cluster either way, so fit's account needs to list and
        // // watch them cluster-wide, Secrets of type kubernetes.io/tls among them, and to patch the
        // // status of GatewayClasses, Gateways and routes.
        // // list of string.
        // "namespaces": ["default"],

        // // The IP address Gateway listeners are bound on, each on its port; every address when left
        // // out.
        // // string.
        // "listen_host": "0.0.0.0",

        // // Where requests to a Service go: endpoints, to its ready endpoints from its EndpointSlices,
        // // balanced by fit; or cluster_ip, to its cluster IP, balanced by the cluster. endpoints when
        // // left out.
        // // one of: endpoints, cluster_ip; default "endpoints".
        // "backends": "endpoints",

        // // The most objects of each kind kept: past it, the rest are left out and reported. 10000 when
        // // left out or 0.
        // // integer, 0 or more; default 10000.
        // "max_objects": 10000,

        // // How long each request to the API server may take, but watches, which last five minutes each.
        // // 10s when left out.
        // // duration, as "1.5s" or "2m"; default "10s".
        // "request_timeout": "10s",

        // // The addresses where clients reach fit's Gateways, IP addresses or host names, written into
        // // each one's status.addresses, as clients of the Gateway API and its conformance tests read
