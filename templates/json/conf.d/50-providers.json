        // // The datacenter whose KV store is read; the agent's when left out.
        // // string.
        // "datacenter": "dc1",

        // // A file holding the ACL token to send, read each time a watch starts; none when left out. The
        // // token needs to read the keys under prefix.
        // // string.
        // "token_file": "/etc/fit/token",

        // // A PEM file with the CAs Consul's certificate is verified with, over https; the system's when
        // // left out.
        // // string.
        // "ca_file": "/etc/fit/ca.pem",

        // // A PEM file with the client certificate sent over https, as Consul's verify_incoming asks
        // // for; with key_file.
        // // string.
        // "cert_file": "/etc/fit/example.com.pem",

        // // A PEM file with cert_file's private key.
        // // string.
        // "key_file": "/etc/fit/example.com.key",

        // // The keys read are those starting with it. Each holds a JSON object of listeners, routes,
        // // upstreams and services, as a config holds them; keys ending in '/' and empty ones are passed
