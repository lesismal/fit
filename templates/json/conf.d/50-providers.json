        // // integer, 0 or more; default 1000.
        // "max_keys": 1000,

        // // How often what the keys provide is sent again whether or not it changed, so that a part
        // // refused because of the rest of the config is tried again. 30s when left out.
        // // duration, as "1.5s" or "2m"; default "30s".
        // "refresh_interval": "30s",

        // // How long each request to Consul may take, connecting included, beyond the five minutes a
        // // blocking query waits for a change. 10s when left out.
        // // duration, as "1.5s" or "2m"; default "10s".
        // "request_timeout": "10s",
      // },

      // // Listeners, routes, upstreams and services from the keys under a prefix in etcd, each holding
      // // a JSON object of them.
      // // object.
      // "etcd": {
        // // Where etcd's client API is: http:// or https:// and a host and port, for each member to try,
