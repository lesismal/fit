// fit's config template as a directory: every field of the config and of every module's
// params, in files by kind. Generated by schema.TemplateDir; regenerate with:
// go test ./schema -update
//
// fit run -c <this directory> reads every file in it, its subdirectories too, in lexical
// order. listeners, routes, upstreams, services and providers are joined across the files;
// any other field is written in one file only. What is written out runs as it is: a
// listener on :8080, example.com answering "hello from fit", and api.example.com proxied
// to 127.0.0.1:9000. Every other field is commented out, with its default or an example:
// uncomment what you need. docs/reference/config.md describes them all.
//
// This file:
// Routes, upstreams, services and listeners from Docker, Consul, etcd and Kubernetes.
{
  // Sources of routes, upstreams, services and listeners other than this file and the Admin API,
  // merged into the config: what this config writes wins over every provider, and a provider
  // over those listed after it; a provider's element named as one before it is left out. The
  // Admin API's /config/effective shows the result and where each part came from. Read when fit
  // starts: a change takes effect when fit restarts.
  // list of object.
  // "providers": [
    // {
      // // The name the provider goes by in the Admin API's /config/effective and in logs: lower-case
      // // letters, digits, '_', '.' and '-', unique among the providers. Its kind, as docker, when
      // // left out.
      // // string.
      // "name": "docker",

      // // Routes, upstreams and services from the labels of running Docker containers.
      // // object.
      // "docker": {
        // // Where the Docker daemon's API is: unix:// and a socket's path, or tcp:// and a host and
        // // port, as of a socket proxy, in plain HTTP. unix:///var/run/docker.sock when left out.
        // // string; default "unix:///var/run/docker.sock".
        // "endpoint": "unix:///var/run/docker.sock",

        // // Take every running container with routes or services in its labels; only those labelled
        // // <label_prefix>.enable=true when left out or false. A container labelled
        // // <label_prefix>.enable=false is never taken.
        // // boolean.
        // "expose_all": true,

        // // The Docker network whose address of a container's is used, when the container is on several
        // // and has no <label_prefix>.network label; the first by name when left out.
        // // string.
        // "network": "web",

        // // Send to the port a container's port is published on, on the host, rather than to the
        // // container's own address: for a fit outside Docker that cannot reach containers' addresses,
        // // as on Docker Desktop.
        // // boolean.
        // "use_published_ports": true,

        // // What the labels read start with, as in fit.routes.web.host. fit when left out.
        // // string; default "fit".
        // "label_prefix": "fit",

        // // The most containers taken; past it, the rest, by name, are left out and reported. 1000 when
        // // left out or 0.
        // // integer, 0 or more; default 1000.
        // "max_containers": 1000,

        // // How often the containers are listed again whether or not an event came, in case one was
        // // missed. 30s when left out.
        // // duration, as "1.5s" or "2m"; default "30s".
        // "refresh_interval": "30s",

        // // How long listing the containers may take, connecting included. 10s when left out.
        // // duration, as "1.5s" or "2m"; default "10s".
        // "request_timeout": "10s",
      // },

      // // Routes, upstreams and services from the tags of the services in a Consul catalog, sending to
      // // their instances whose health checks pass.
      // // object.
      // "consul": {
        // // Where Consul's HTTP API is, as of the local agent: http:// or https:// and a host and port.
        // // http://127.0.0.1:8500 when left out.
        // // string; default "http://127.0.0.1:8500".
        // "endpoint": "http://127.0.0.1:8500",

        // // The datacenter whose catalog is read; the agent's when left out.
        // // string.
        // "datacenter": "dc1",

        // // A file holding the ACL token to send, read each time a watch starts; none when left out. The
        // // token needs to read the services and nodes served.
        // // string.
        // "token_file": "/etc/fit/token",

        // // A PEM file with the CAs Consul's certificate is verified with, over https; the system's when
        // // left out.
        // // string.
        // "ca_file": "/etc/fit/ca.pem",

        // // A PEM file with the client certificate sent over https, as Consul's verify_incoming asks
        // // for; with key_file.
        // // string.
        // "cert_file": "/etc/fit/example.com.pem",

        // // A PEM file with cert_file's private key.
        // // string.
        // "key_file": "/etc/fit/example.com.key",

        // // Take every service in the catalog; only those tagged <tag_prefix>.enable=true when left out
        // // or false. An instance tagged <tag_prefix>.enable=false is never taken.
        // // boolean.
        // "expose_all": true,

        // // What the tags read start with, as in fit.routes.web.host=example.com; tags without '=' are
