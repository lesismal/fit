        // // How often the catalog is read again whether or not it changed. 30s when left out.
        // // duration, as "1.5s" or "2m"; default "30s".
        // "refresh_interval": "30s",

        // // How long each request to Consul may take, connecting included, beyond the five minutes a
        // // blocking query waits for a change. 10s when left out.
        // // duration, as "1.5s" or "2m"; default "10s".
        // "request_timeout": "10s",
      // },

      // // Listeners, routes, upstreams and services from the keys under a prefix in Consul's KV store,
      // // each holding a JSON object of them.
