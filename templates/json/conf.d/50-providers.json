        // // string.
        // "ca_file": "/etc/fit/ca.pem",

        // // A PEM file with the client certificate sent over https, as etcd's client-cert-auth asks for;
        // // with key_file.
        // // string.
        // "cert_file": "/etc/fit/example.com.pem",

        // // A PEM file with cert_file's private key.
        // // string.
        // "key_file": "/etc/fit/example.com.key",

        // // The keys read are those starting with it. Each holds a JSON object of listeners, routes,
        // // upstreams and services, as a config holds them; keys ending in '/' and empty ones are passed
        // // over, and a key whose value is not such an object is left out and reported. fit/ when left
        // // out.
        // // string; default "fit/".
        // "prefix": "fit/",

        // // The most keys taken; past it, the rest, by key, are left out and reported. 1000 when left
