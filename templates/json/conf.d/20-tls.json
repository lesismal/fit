// fit's config template as a directory: every field of the config and of every module's
// params, in files by kind. Generated by schema.TemplateDir; regenerate with:
// go test ./schema -update
//
// fit run -c <this directory> reads every file in it, its subdirectories too, in lexical
// order. listeners, routes, upstreams, services and providers are joined across the files;
// any other field is written in one file only. What is written out runs as it is: a
// listener on :8080, example.com answering "hello from fit", and api.example.com proxied
// to 127.0.0.1:9000. Every other field is commented out, with its default or an example:
// uncomment what you need. docs/reference/config.md describes them all.
//
// This file:
// Certificates: HTTPS by default, and how ACME obtains and renews certificates.
{
  // HTTPS by default: a config that writes no listeners is served over HTTPS on port 443, with
  // certificates obtained with acme for the host names its routes match, and over HTTP on port
  // 80 only to be redirected; a listener whose tls is empty gets certificates for the host names
  // of the routes it serves. On when left out.
  // object.
  // "auto_https": {
    // // Turn HTTPS by default off: no listeners are made for a config that writes none, and an empty
    // // tls gets no certificates.
    // // boolean.
    // "disable": true,

    // // Make no listener in the clear to redirect to HTTPS. ACME's HTTP-01 challenge is then
    // // answered by none, and certificates come through TLS-ALPN-01.
    // // boolean.
    // "disable_redirects": true,

    // // The port of the listener in the clear that redirects to HTTPS. 80 when left out or 0.
    // // integer, 0 to 65535; default 80.
    // "http_port": 80,

    // // The port of the HTTPS listener, and the one redirects name when it is not 443. 443 when left
    // // out or 0.
    // // integer, 0 to 65535; default 443.
    // "https_port": 443,
  // },

