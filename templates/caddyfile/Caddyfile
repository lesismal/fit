# fit's Caddyfile template: every global option, site address, matcher, directive and
# subdirective fit converts from a Caddyfile.
#
# What is written out converts as it is: a site on :8080 using every directive, and
# commented-out sites for the other address forms. Before running it, point root, the
# upstreams and php_fastcgi at what this host has: fit validate checks that the directories
# exist. Lines starting with "# " are code to uncomment; lines starting with "## " explain.
# Choices are listed as  a | b | c.
#
# Check it:      fit validate -c Caddyfile
# See the JSON:  fit adapt -c Caddyfile
#
# What a Caddyfile cannot say (layer 4 services, caching, rate limits, JWT, WASM, providers,
# telemetry and fit's limits) is in the YAML and JSON templates, ../yaml and ../json. The
# Caddyfile reference, docs/reference/caddyfile.md, says what each line converts to.

## ---------------------------------------------------------------------------------------
## Global options: one block, first, with no address.
## ---------------------------------------------------------------------------------------
{
	## The ACME account's email, for the CA to write to about certificates.
	email ops@example.com

	## The ACME CA's directory; Let's Encrypt's when left out. Its staging CA, for tests:
	## https://acme-staging-v02.api.letsencrypt.org/directory
	# acme_ca https://acme-v02.api.letsencrypt.org/directory

	## A PEM file of the CA's root, for a CA of one's own.
	# acme_ca_root /etc/fit/acme-ca.pem

	## Where accounts, keys and certificates are kept; $XDG_DATA_HOME/fit when left out.
	## Also:  storage file_system { root /var/lib/fit }
	# storage file_system /var/lib/fit

	## The Admin API: on at localhost:2019 unless "admin off".
	## admin off | admin <host:port> | admin unix//run/fit/admin.sock
	admin localhost:2019

	## HTTPS by default.
	## auto_https off | disable_redirects | disable_certs
	# auto_https disable_redirects

	## The ports of HTTP and HTTPS by default, and of sites that name no port.
	# http_port 80
	# https_port 443

	## On-demand TLS: whom to ask before obtaining a certificate during a handshake, for sites
	## whose tls block says on_demand. "interval" and "burst" bound how many are obtained.
	# on_demand_tls {
	# 	ask http://127.0.0.1:5555/allowed
	# 	## or:  permission http { endpoint http://127.0.0.1:5555/allowed }
	# 	interval 1m
	# 	burst 10
	# }

	## The protocols served: h1 | h2 | h2c | h3. h2 and h3 apply to sites over TLS, h2c to
	## those in the clear.
	servers {
		protocols h1 h2 h2c
	}
}

## ---------------------------------------------------------------------------------------
## Snippets: defined once, imported anywhere, with {args[0]}, {args[1]}... {args[:]}.
## Environment variables: {$NAME}, or {$NAME:default} when unset.
## ---------------------------------------------------------------------------------------
(security_headers) {
	header {
		## A field and a value sets it; +Field adds a value; -Field deletes it;
		## ?Field sets it as set; >Field too.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options {args[0]}
		-Server
	}
}

## ---------------------------------------------------------------------------------------
## A site. Its addresses, separated by spaces or commas: [scheme://][host][:port][/path]
##   example.com            HTTPS on 443, HTTP on 80 redirected to it
##   *.example.com          one label below example.com
##   example.com:8443       HTTPS on 8443
##   http://example.com     HTTP on 80          https://example.com   HTTPS on 443
##   :8080                  HTTP on 8080, any host
##   example.com/api/*      the site matches the path too
## localhost and IP addresses are served over HTTP: fit has no internal CA.
## ---------------------------------------------------------------------------------------
:8080 {
	## The host its listener binds; every address when left out.
	bind 127.0.0.1

	## The access log, of JSON lines.  output stdout | stderr | file <path> | discard
	log {
		output stdout
		format json
	}

	import security_headers DENY

	## -- Named matchers. A directive's first argument may be: * | /path | @name ----------
	## A path is exact, a prefix ending in *, or has * anywhere (*.css).
	@api {
		path /api/*
		## GET | POST | PUT | DELETE | ...
		method GET POST PUT DELETE
	}
	@static path *.css *.js *.png /favicon.ico
	@internal {
		## remote_ip | client_ip <ranges...>; private_ranges for the private networks
		remote_ip private_ranges
	}
	@json {
		## header <field> <value...> | header <field> * (any value) | header !<field> (absent)
		header Accept application/json
	}
	@debug {
		## query <key>=<value> | <key>=* (any value)
		query debug=1
	}
	@legacy {
		## path_regexp [name] <regexp>, in Go's syntax
		path_regexp ^/v1/
	}
	@public {
		## not <matcher>, or a block of matchers that must not all hold
		not path /admin/*
	}
	@hosts host example.com www.example.com

	## -- The site's root: for file_server and php_fastcgi --------------------------------
	root * /srv/www

	## -- Compression. zstd | gzip | br; zstd and gzip when none are named ---------------
	encode zstd gzip {
		minimum_length 512
	}

	## -- Request fields, set before the handler sees them -------------------------------
	request_header X-Env prod

	## -- Request bodies' size. 10MB = 10,000,000 bytes; 10MiB = 10,485,760 --------------
	request_body /upload/* {
		max_size 100MB
	}

	## -- Redirects. redir [matcher] <to> [permanent | temporary | 301 | 302 | 303 | 307 | 308]
	## Placeholders: {uri} {path} {query} {host} {scheme}
	redir /old/* /new{uri} permanent

	## -- Rewrites, applied after the route is picked ------------------------------------
	## rewrite [matcher] /prefix{path}   adds a prefix; rewrite [matcher] /path   replaces it
	rewrite @legacy /v2{path}
	## uri strip_prefix <p> | strip_suffix <s> | replace <find> <with> | path_regexp <re> <with>
	uri /docs/* strip_prefix /docs

	## -- Basic authentication. basic_auth [matcher] [bcrypt [realm]] { <user> <hash> } ---
	## Hashes are bcrypt: fit hash-password, or htpasswd -B.
	basic_auth /admin/* bcrypt admin {
		alice $2a$14$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG
	}

	## -- An auth service asked before each request --------------------------------------
	forward_auth /account/* 127.0.0.1:9091 {
		uri /api/verify
		copy_headers Remote-User Remote-Groups
	}

	## -- Fixed answers. respond [matcher] [<body>] [<status>] { body <text> } -----------
	respond /health "ok" 200
	## error [matcher] [<message>] <status>: an answer of the status, with no body
	error /forbidden/* 403

	## -- A reverse proxy ----------------------------------------------------------------
	## Upstreams: host:port | :port (localhost) | http://host | https://host (TLS) |
	## h2c://host:port | host:8001-8004 (a range of ports)
	reverse_proxy @api 127.0.0.1:9000 127.0.0.1:9001 {
		## More upstreams.
		to 127.0.0.1:9002

		## round_robin | least_conn | random | random_choose (P2C) | ip_hash |
		## client_ip_hash | uri_hash | header <field> | cookie [<name>] |
		## weighted_round_robin <weight per upstream...>
		lb_policy least_conn
		## Retries after a failure: lb_retries <n>, or lb_try_duration <d>.
		lb_retries 2

		## Active health checks.
		health_uri /healthz
		health_port 9100
		health_interval 5s
		health_timeout 2s
		## A status that passes; any of 200-399 when left out.
		health_status 200
		health_passes 2
		health_fails 2
		health_headers {
			Host app.internal
		}

		## Passive health: max_fails failures within fail_duration take an upstream out.
		fail_duration 30s
		max_fails 3

		## Fields of the request sent upstream, and of the response. Host sets the proxy's
		## Host; {upstream_hostport} is the upstream's address, with one upstream.
		header_up Host app.internal
		header_up X-Env prod
		header_up -Cookie
		header_down -X-Powered-By

		## The proxies in front of fit, whose X-Forwarded-* are believed.
		trusted_proxies private_ranges
		## How long a WebSocket or other tunnel may be idle.
		stream_timeout 10m

		transport http {
			## h2c: HTTP/2 in the clear. tls: TLS, with HTTP/2 when the server offers it.
			# versions h2c
			# tls
			# tls_server_name app.internal
			# tls_trusted_ca_certs /etc/fit/upstream-ca.pem
			## or:  tls_trust_pool file /etc/fit/upstream-ca.pem
			# tls_client_auth /etc/fit/client.pem /etc/fit/client.key
			dial_timeout 5s
			response_header_timeout 60s
			read_timeout 60s
			## keepalive <d> | off
			keepalive 60s
			keepalive_idle_conns 32
			max_conns_per_host 256
		}
	}

	## -- handle: blocks of which one takes a request, by their matchers -----------------
	handle /internal/* {
		reverse_proxy @internal h2c://127.0.0.1:50051
	}

	## -- handle_path: handle with the path's prefix stripped ----------------------------
	handle_path /assets/* {
		file_server {
			root /srv/assets
			## Twins name.br, name.zst and name.gz, served to clients that accept them:
			## br | zstd | gzip; all three when none are named.
			precompressed br gzip
		}
	}

	## -- A single-page app: the files tried for a request, for file_server and php_fastcgi
	handle /app/* {
		root * /srv/app
		## try_files [matcher] <files...>: {path} is the request's path; a last =404 is
		## what fit answers anyway.
		try_files {path} {path}/ /index.html
		file_server
	}

	## -- route: directives applied in the order written, not Caddy's order --------------
	route /beta/* {
		header X-Beta 1
		respond "beta"
	}

	## -- PHP over FastCGI ---------------------------------------------------------------
	## php_fastcgi [matcher] <host:port | unix//path.sock> { ... }
	php_fastcgi /php/* unix//run/php/php-fpm.sock {
		root /var/www/php
		split .php
		## index <file> | index off
		index index.php
		env APP_ENV prod
		dial_timeout 5s
		read_timeout 60s
		## try_files <files...>; {path} {path}/index.php /index.php when left out
	}

	## -- Static files: file_server [matcher] [browse] { ... } ---------------------------
	file_server {
		## A directory without an index file is listed.
		browse
		## The files that stand for a directory; index.html when left out.
		index index.html index.htm
		## root <path>: in place of the site's root.
	}

	## Requests counted and timed for the Admin API's /metrics.
	metrics
}

## ---------------------------------------------------------------------------------------
## Sites over HTTPS: uncomment, with names DNS points at this host.
## ---------------------------------------------------------------------------------------
# example.com, www.example.com {
# 	## Certificates: from ACME when there is no tls line, or one of:
# 	##   tls <cert.pem> <key.pem>     files
# 	##   tls <email>                  the ACME account's email
# 	tls /etc/fit/example.com.pem /etc/fit/example.com.key
# 	reverse_proxy 127.0.0.1:9000
# }

# *.example.com {
# 	tls {
# 		## A certificate obtained during the handshake: needs on_demand_tls.
# 		on_demand
# 		## Mutual TLS. mode require_and_verify | verify_if_given
# 		client_auth {
# 			mode require_and_verify
# 			trusted_ca_cert_file /etc/fit/clients-ca.pem
# 			## or:  trust_pool file /etc/fit/clients-ca.pem
# 		}
# 		## The CA and account for this site's certificates.
# 		issuer acme {
# 			email ops@example.com
# 			dir https://acme-v02.api.letsencrypt.org/directory
# 		}
# 	}
# 	respond "hello"
# }

## A site in the clear, on port 80.
# http://static.example.com {
# 	root * /srv/static
# 	file_server
# }
