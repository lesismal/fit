# The HTTP/3 load generator fitbench runs: h2load built with HTTP/3, which
# no distribution's package has, on ngtcp2 and nghttp3 over OpenSSL 3.5's
# QUIC API; with Debian's curl, which speaks HTTP/3, to check each server's
# responses first. HTTP/1.1 and h2c keep their own image, Dockerfile, so
# that their results stay comparable with earlier runs.
ARG BASE=debian:trixie
FROM ${BASE} AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential pkg-config curl ca-certificates xz-utils \
        libssl-dev libev-dev zlib1g-dev libc-ares-dev libbrotli-dev \
    && rm -rf /var/lib/apt/lists/*
ARG NGHTTP3=1.12.0
ARG NGTCP2=1.16.0
ARG NGHTTP2=1.68.0
WORKDIR /src
RUN curl -fsSL https://github.com/ngtcp2/nghttp3/releases/download/v${NGHTTP3}/nghttp3-${NGHTTP3}.tar.xz | tar xJ \
    && cd nghttp3-${NGHTTP3} && ./configure --prefix=/opt/h3 --enable-lib-only && make -j"$(nproc)" install
RUN curl -fsSL https://github.com/ngtcp2/ngtcp2/releases/download/v${NGTCP2}/ngtcp2-${NGTCP2}.tar.xz | tar xJ \
    && cd ngtcp2-${NGTCP2} && PKG_CONFIG_PATH=/opt/h3/lib/pkgconfig ./configure --prefix=/opt/h3 --enable-lib-only --with-openssl \
    && make -j"$(nproc)" install
RUN curl -fsSL https://github.com/nghttp2/nghttp2/releases/download/v${NGHTTP2}/nghttp2-${NGHTTP2}.tar.xz | tar xJ \
    && cd nghttp2-${NGHTTP2} && PKG_CONFIG_PATH=/opt/h3/lib/pkgconfig LDFLAGS=-Wl,-rpath,/opt/h3/lib \
        ./configure --prefix=/opt/h3 --enable-app --enable-http3 --disable-python-bindings --without-jemalloc \
    && make -j"$(nproc)" install \
    && /opt/h3/bin/h2load --version

FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates libssl3t64 libev4t64 zlib1g libc-ares2 libbrotli1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/h3 /opt/h3
RUN ln -s /opt/h3/bin/h2load /usr/local/bin/h2load && h2load --version && curl --version | grep -q HTTP3
