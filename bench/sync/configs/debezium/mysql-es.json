{
  "name": "bench",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "tasks.max": "1",
    "database.hostname": "mysql",
    "database.port": "3306",
    "database.user": "root",
    "database.password": "fit-syncbench-1",
    "database.server.id": "4102",
    "topic.prefix": "bench",
    "database.include.list": "shop",
    "table.include.list": "shop.items",
    "snapshot.mode": "no_data",
    "include.schema.changes": "false",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
    "schema.history.internal.kafka.topic": "bench-schema-history",
    "transforms": "index",
    "transforms.index.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.index.regex": "bench\\.shop\\.items",
    "transforms.index.replacement": "bench"
  }
}
