{
  "admin": {"address": "127.0.0.1:9004"},
  "metrics": {},
  "listeners": [{"name": "cachebackend", "address": ":9003"}],
  "routes": [
    {
      "name": "cache",
      "match": {"path": ["/cache/*"]},
      "handler": {"module": "respond", "params": {"body": "{{CACHEBODY}}",
        "headers": {"Content-Type": "text/plain", "Cache-Control": "max-age=600"}}}
    }
  ]
}
