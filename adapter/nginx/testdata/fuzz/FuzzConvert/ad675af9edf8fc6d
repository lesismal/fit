string("# A single-page app with its assets, a health check and an old path.\nhttp {\n    server {\n        listen 8080;\n        server_name app.test *.app.test;\n        root /srv/app;\n        index index.html;\n\n        add_header X-Frame-Options DENY;\n\n        location = /health {\n            return 200 \"ok\";\n        }\n\n        location ~* \\.(css|js|png)$ {\n            add_header Cache-Control \"public, max-age=86400\";\n        }\n\n        location ^~ /downloads/ {\n            alias /srv/files/;\n        }\n\n        location /old/ {\n            rewrite ^/old/(.*)$ /new/$1 permanent;\n        }\n\n        \xfa\x00\x00\xfation /docs/ {\n            rewrite ^/docs/(.*)$ /manual/$1 break;\n            try_files $uri $uri/ =404;\n        }\n\n        location / {\n            try_files $uri $uri/ /index.html;\n        }\n    }\n}\n")
