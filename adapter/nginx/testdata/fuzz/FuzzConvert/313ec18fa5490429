string("# A reverse proxy: HTTP sent to HTTPS, an API behind a balanced upstream.\nhttp {\n    limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;\n\n    upstream backend {\n        least_conn;\n        server 10.0.0.1:8080 weight=3 max_fails=2 fail_timeout=30s;\n        server 10.0.0.2:8080;\n        server 10.0.0.3:8080 backup;\n        keepalive 64;\n    }\n\n    server {\n        listen 80;\n        listen [::]:80;\n        server_name example.com www.example.com;\n        return 301 https://$host$request_uri;\n    }\n\n    server {\n        listen 443 ssl http2;\n        server_name example.com www.example.com;\n        ssl_certificate     /etc/ssl/example.\xbb\xbb\xbb\xbb\xbb\xbb\xbb\xbbcom.crt;\n        ssl_certificate_key /etc/ssl/example.com.key;\n        ssl_protocols TLSv1.2 TLSv1.3;\n        client_max_body_size 10m;\n        gzip on;\n\n        location /api/ {\n            limit_req zone=api burst=40 nodelay;\n            proxy_pass http://backend/v1/;\n            proxy_http_version 1.1;\n            proxy_set_header Host $host;\n            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n            proxy_set_header X-Forwarded-Proto $scheme;\n            proxy_set_header X-Real-IP $remote_addr;\n            proxy_set_header X-Env production;\n            proxy_connect_timeout 5s;\n            proxy_read_timeout 2m;\n        }\n\n        location / {\n            proxy_pass http://127.0.0.1:3000;\n        }\n    }\n}\n")
