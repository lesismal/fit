# The Caddyfile twin of proxy.json: a reverse proxy to two upstreams, with
# timeouts and health checks; fit's limits keep their defaults.
{
	admin 127.0.0.1:2019
	servers {
		protocols h1 h2c
	}
}

:8080 {
	reverse_proxy /api/* 127.0.0.1:9000 127.0.0.1:9001 {
		trusted_proxies 10.0.0.0/8
		health_uri /healthz
		health_interval 5s
		health_timeout 2s
		health_fails 2
		health_passes 2
		fail_duration 10s
		max_fails 1
		transport http {
			dial_timeout 10s
			response_header_timeout 60s
			read_timeout 60s
			keepalive 60s
			keepalive_idle_conns 32
			max_conns_per_host 256
		}
	}
	respond "not found" 404
}
