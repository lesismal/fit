// Mutual TLS: the listener asks every client for a certificate signed by the
// CA in clients-ca.pem and refuses the handshake without one. The server's own
// certificate comes from ACME. clients-ca.pem is a throwaway CA's certificate
// (no key kept): use your own.
// Run one file, from the repository's root: fit run -c examples/mtls/fit.json
// fit.json, fit.yaml and fit.conf here say the same; -c on the directory would join all three.
{
  "listeners": [
    {
      "name": "https",
      "address": ":443",
      "protocols": ["http/1.1", "h2"],
      "tls": {
        "acme": ["internal-api.example.com"],
        "client_auth": {
          // Watched: a change loads the config again.
          "ca_files": ["examples/mtls/clients-ca.pem"],
          // A listener that requires certificates cannot answer TLS-ALPN-01,
          // so the CA's HTTP-01 challenge comes to port 80.
          "mode": "require"
        }
      }
    },
    {"name": "http", "address": ":80", "protocols": ["http/1.1"]}
  ],
  "upstreams": [
    {"name": "api", "addresses": ["127.0.0.1:9000"]}
  ],
  "routes": [
    {
      "name": "api",
      "listeners": ["https"],
      "middleware": [
        // Tell the upstream who the client is.
        {"module": "client_cert", "params": {"subject_header": "X-Client-Subject"}}
      ],
      "handler": {"module": "proxy", "params": {"upstream": "api"}}
    }
  ],
  "acme": {
    "email": "ops@example.com",
    "challenges": ["http-01"]
  }
}
