// An agent client: an OpenAI- and Anthropic-compatible API on
// 127.0.0.1:9301 (/v1/chat/completions, /v1/messages) that calls the models of
// the nodes the hub (examples/agent-hub) reaches. API keys are made on its
// console, 127.0.0.1:9300, user admin, password example-password. The id is
// written out, as fit would otherwise write a new one back into this file.
// Run one file, from the repository's root: fit run -c examples/agent-client/fit.json
// fit.json, fit.yaml and fit.conf here say the same; -c on the directory would join all three.
{
  "agent": {
    "client": {
      "id": "client-7a3e91c04d5b2f68",
      "name": "laptop",
      "console": {
        "address": "127.0.0.1:9300",
        "users": [{"username": "admin", "password_hash": "$2a$10$gkDJyGagxp1q7R24F0rSjulsgZOFL55Zm6JK2RcxTCLDk23szhZA2"}]
      },
      "peers": [{"address": "127.0.0.1:9210", "password": "mesh-secret", "role": "hub"}],
      "api": {
        // Off loopback, it needs cert_file and key_file.
        "address": "127.0.0.1:9301",
        "max_body_bytes": 33554432,
        "max_inflight": 64,
        "first_byte_timeout": "5m",
        "timeout": "30m"
      }
    }
  }
}
