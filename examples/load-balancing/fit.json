// Load balancing: weighted least-connections over three backends, sticky
// sessions by cookie, active health checks with passive ones beside them,
// retries within a budget, a 5% canary, a failover pool and mirrored traffic.
// Run one file, from the repository's root: fit run -c examples/load-balancing/fit.json
// fit.json, fit.yaml and fit.conf here say the same; -c on the directory would join all three.
{
  "listeners": [
    {"name": "web", "address": ":8080", "protocols": ["http/1.1", "h2c"]}
  ],
  "upstreams": [
    {
      "name": "app",
      "addresses": ["10.0.0.11:8080", "10.0.0.12:8080", "10.0.0.13:8080"],
      // The third backend is a smaller machine: it takes half as much.
      "weights": [2, 2, 1],
      "load_balancing": "least_conn",
      // A client keeps going to the backend it was first sent to.
      "sticky_cookie": {"name": "fit_backend", "max_age": "1h", "secure": true},
      "max_conns": 512,
      "connect_timeout": "3s",
      // Passive checks: a backend failing 3 times in 30s leaves rotation for 30s.
      "max_fails": 3,
      "fail_timeout": "30s",
      // Active checks: out after 2 failures, back after 2 passes.
      "health_check": {
        "path": "/healthz",
        "expect_status": [200, 204],
        "interval": "5s",
        "timeout": "2s",
        "fails": 2,
        "passes": 2
      }
    },
    {
      "name": "app-canary",
      "addresses": ["10.0.1.11:8080"],
      "health_check": {"path": "/healthz"}
    },
    {
      // Takes the requests while no backend of app is in rotation.
      "name": "app-backup",
      "addresses": ["10.0.2.11:8080"],
      "health_check": {"type": "tcp", "interval": "10s"}
    },
    {
      // Gets a copy of the requests; its answers are thrown away.
      "name": "shadow",
      "addresses": ["10.0.3.11:8080"]
    }
  ],
  "routes": [
    {
      "name": "app",
      "handler": {
        "module": "proxy",
        "params": {
          // 95 of 100 requests to app, 5 to the canary.
          "upstreams": [
            {"upstream": "app", "weight": 95},
            {"upstream": "app-canary", "weight": 5}
          ],
          "failover": "app-backup",
          "mirror": {"upstream": "shadow", "percent": 10},
          // Retry idempotent requests on another backend, but never more than
          // a fifth of the traffic, so retries cannot pile onto an outage.
          "retry": {
            "attempts": 2,
            "statuses": [502, 503, 504],
            "budget_ratio": 0.2,
            "budget_min_per_second": 10
          },
          "timeout": "30s"
        }
      }
    }
  ]
}
