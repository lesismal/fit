// The console: web pages behind a login, from which the whole config is read
// and changed, kept encrypted in admin.store, which fit runs from once it is
// made. The user is admin, password example-password, its hash made with
// fit hash-password. The store's password comes from FIT_STORE_PASSWORD.
// Run one file, from the repository's root:
//   FIT_STORE_PASSWORD=change-me fit run -c examples/console/fit.json
// fit.json, fit.yaml and fit.conf here say the same; -c on the directory would join all three.
// Then open http://127.0.0.1:2020/
{
  "listeners": [
    {"name": "web", "address": ":8080", "protocols": ["http/1.1", "h2c"]}
  ],
  "routes": [
    {"name": "hello", "handler": {"module": "respond", "params": {"body": "hello\n"}}}
  ],
  "admin": {
    "address": "127.0.0.1:2019",
    "store": {
      // Every config applied is written here; what this file sets beside
      // admin is only the store's first content.
      "path": "/tmp/fit-example.store",
      "password_env": "FIT_STORE_PASSWORD"
    },
    "console": {
      // Off loopback, it needs cert_file and key_file.
      "address": "127.0.0.1:2020",
      "users": [
        {"username": "admin", "password_hash": "$2a$10$gkDJyGagxp1q7R24F0rSjulsgZOFL55Zm6JK2RcxTCLDk23szhZA2"}
      ],
      "session_timeout": "30m",
      "session_lifetime": "12h",
      "max_sessions": 16
    }
  }
}
