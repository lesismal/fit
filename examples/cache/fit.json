// An HTTP cache in front of an upstream, by RFC 9111's rules: 256 MiB in
// memory, many misses for one response making one fetch, and stale responses
// served while the upstream is refetched or down. A disk tier is one more
// param, as disk {"path": "/var/cache/fit", "max_bytes": 10737418240}; it is
// left out here because fit validate makes its directory.
// Run one file, from the repository's root: fit run -c examples/cache/fit.json
// fit.json, fit.yaml and fit.conf here say the same; -c on the directory would join all three.
{
  "listeners": [
    {"name": "web", "address": ":8080", "protocols": ["http/1.1", "h2c"]}
  ],
  "upstreams": [
    {"name": "origin", "addresses": ["127.0.0.1:9000"]}
  ],
  "routes": [
    {
      "name": "cached",
      "match": {"method": ["GET", "HEAD"]},
      "middleware": [
        {
          "module": "cache",
          "params": {
            // Routes naming the same zone share its store.
            "zone": "origin",
            "max_bytes": 268435456,
            "max_entry_bytes": 8388608,
            // For responses that say nothing of their lifetime.
            "default_ttl": "5m",
            "lock_timeout": "5s",
            "stale_while_revalidate": "1m",
            "stale_if_error": "1h"
          }
        }
      ],
      "handler": {"module": "proxy", "params": {"upstream": "origin"}}
    },
    {
      "name": "uncached",
      "priority": -1,
      "handler": {"module": "proxy", "params": {"upstream": "origin"}}
    }
  ]
}
