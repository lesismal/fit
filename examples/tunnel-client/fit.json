// A tunnel client: local ports forwarded through the server
// (examples/tunnel-server) to the services of a node (examples/tunnel-node).
// Then ssh -p 2222 127.0.0.1 reaches the lab's 10.0.0.5:22.
// Run one file, from the repository's root: fit run -c examples/tunnel-client/fit.json
// fit.json, fit.yaml and fit.conf here say the same; -c on the directory would join all three.
{
  "tunnel": {
    "client": {
      "name": "alice",
      "servers": [
        {
          "name": "hub",
          "endpoints": [{"address": "127.0.0.1:7000"}],
          "password": "a-registration-password",
          "body_password": "a-body-password"
        }
      ],
      "forwards": [
        {"listen": "127.0.0.1:2222", "node": "lab", "service": "ssh"},
        {"listen": "127.0.0.1:8888", "node": "lab", "service": "web"}
      ],
      "open_timeout": "20s",
      "max_tunnels": 1024
    }
  }
}
