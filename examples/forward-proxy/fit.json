// An HTTP CONNECT forward proxy for the clients of one network, to HTTPS
// sites only, with the cloud metadata address refused.
// Run one file, from the repository's root: fit run -c examples/forward-proxy/fit.json
// fit.json, fit.yaml and fit.conf here say the same; -c on the directory would join all three.
// Try it: curl -x http://127.0.0.1:3128 https://example.com/
{
  "listeners": [
    {"name": "proxy", "address": ":3128", "protocols": ["http/1.1"]}
  ],
  "routes": [
    {
      "name": "connect",
      "match": {"method": ["CONNECT"]},
      "handler": {
        "module": "forward_proxy",
        "params": {
          // Who may use it.
          "clients": ["127.0.0.1/32", "10.0.0.0/8"],
          // Where it connects: anything but these.
          "deny": ["169.254.169.254", "10.0.0.0/8"],
          "ports": [443],
          "connect_timeout": "10s",
          "idle_timeout": "5m"
        }
      }
    },
    {
      "name": "not-connect",
      "priority": -1,
      "handler": {"module": "respond", "params": {"status": 405, "body": "CONNECT only\n"}}
    }
  ]
}
