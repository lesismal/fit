// PHP through PHP-FPM: each path runs its own script when there is one, and
// everything else runs index.php, the front controller most PHP applications
// want. Static assets are better served by the static handler, on a route of
// their own (see examples/static).
// Run one file, from the repository's root: fit run -c examples/fastcgi/fit.json
// fit.json, fit.yaml and fit.conf here say the same; -c on the directory would join all three.
{
  "listeners": [
    {"name": "web", "address": ":8080", "protocols": ["http/1.1", "h2c"]}
  ],
  "routes": [
    {
      "name": "php",
      "handler": {
        "module": "fastcgi",
        "params": {
          // PHP-FPM's socket; "127.0.0.1:9000" for one on TCP.
          "address": "unix//run/php/php-fpm.sock",
          // The document root as PHP-FPM sees it.
          "root": "/srv/app/public",
          // /index.php/a/b runs /index.php with PATH_INFO /a/b.
          "split_path": [".php"],
          "try_files": ["{path}", "{path}/index.php", "/index.php"],
          // More FastCGI parameters, after fit's own.
          "env": {"APP_ENV": "production"},
          // At most 32 requests at PHP-FPM at once, 8 idle connections kept.
          "max_conns": 32,
          "max_idle_conns": 8,
          "max_pending": 512,
          "response_header_timeout": "60s",
          "timeout": "5m"
        }
      }
    }
  ]
}
