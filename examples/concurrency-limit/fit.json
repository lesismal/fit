// A concurrency limit: at most 50 report requests under way at once, so that a
// slow, expensive endpoint cannot take every backend connection; the rest are
// answered 503 at once.
// Run one file, from the repository's root: fit run -c examples/concurrency-limit/fit.json
// fit.json, fit.yaml and fit.conf here say the same; -c on the directory would join all three.
{
  "listeners": [
    {"name": "web", "address": ":8080", "protocols": ["http/1.1", "h2c"]}
  ],
  "upstreams": [
    {"name": "reports", "addresses": ["127.0.0.1:9000"], "response_timeout": "5m"}
  ],
  "routes": [
    {
      "name": "reports",
      "match": {"path": ["/reports/*"]},
      "middleware": [
        {"module": "concurrency_limit", "params": {"max": 50, "status": 503}}
      ],
      "handler": {"module": "proxy", "params": {"upstream": "reports"}}
    }
  ]
}
