// Routes and upstreams from the Consul catalog: services tagged
// fit.enable=true and fit.routes.web.host=..., sent to their instances whose
// health checks pass.
// Run one file, from the repository's root: fit run -c examples/provider-consul/fit.json
// fit.json, fit.yaml and fit.conf here say the same; -c on the directory would join all three.
{
  "listeners": [
    {"name": "web", "address": ":8080", "protocols": ["http/1.1", "h2c"]}
  ],
  "providers": [
    {
      "name": "consul",
      "consul": {
        "endpoint": "http://127.0.0.1:8500",
        "datacenter": "dc1",
        // An ACL token that may read the services; not in this directory.
        "token_file": "/etc/fit/consul-token",
        "tag_prefix": "fit",
        "max_services": 1000,
        "refresh_interval": "30s"
      }
    }
  ]
}
