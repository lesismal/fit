// The tunnel's hub, on a host both sides can reach: nodes behind NAT
// (examples/tunnel-node) and proxies (examples/tunnel-proxy) link to it, and
// it joins a proxy's tunnels to a node's services. Its console is on
// 127.0.0.1:7080, user admin, password example-password.
// Run one file, from the repository's root: fit run -c examples/tunnel-hub/fit.json
// fit.json, fit.yaml and fit.conf here say the same; -c on the directory would join all three.
{
  "tunnel": {
    "hub": {
      "name": "hub",
      // What nodes and proxies register with; never sent over the network.
      "password": "a-registration-password",
      // Encrypts every frame's body; nodes and proxies need the same.
      "body_password": "a-body-password",
      "listeners": [
        {"protocol": "tcp", "address": ":7000"},
        // For networks that let only HTTP through.
        {"protocol": "ws", "address": ":7001", "path": "/tunnel"}
      ],
      "console": {
        "address": "127.0.0.1:7080",
        "users": [{"username": "admin", "password_hash": "$2a$10$gkDJyGagxp1q7R24F0rSjulsgZOFL55Zm6JK2RcxTCLDk23szhZA2"}]
      },
      "max_peers": 1024,
      "max_tunnels": 16384
    }
  }
}
