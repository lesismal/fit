// Limits and engine tuning for a busy edge: every listener's bounds on
// connections, header and body sizes and the bytes waiting for slow clients,
// and fib's event loops, workers and buffers. Left out, each has a safe default.
// Run one file, from the repository's root: fit run -c examples/limits/fit.json
// fit.json, fit.yaml and fit.conf here say the same; -c on the directory would join all three.
{
  "listeners": [
    {"name": "web", "address": ":8080", "protocols": ["http/1.1", "h2c"]}
  ],
  "routes": [
    {"name": "hello", "handler": {"module": "respond", "params": {"body": "hello\n"}}}
  ],
  "limits": {
    // Bytes waiting for slow clients, in all: a share of memory, or bytes.
    "max_pending_bytes": "25%",
    "max_header_bytes": 65536,
    "max_conns": 200000,
    "max_body_bytes": 33554432,
    // Bytes waiting to be written to one connection.
    "max_write_queue_bytes": 8388608,
    // A client that takes nothing for this long is closed.
    "write_stall_timeout": "30s"
  },
  "engine": {
    // 0 for fib's own choice, from the CPUs.
    "event_loops": 8,
    "workers": 64,
    "min_workers": 8,
    "task_queue": 65536,
    "read_buffer_size": 65536,
    // A connection stops reading past this many bytes unwritten.
    "write_watermark": 262144,
    "backlog": 4096
  }
}
