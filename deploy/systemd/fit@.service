# Several fits on one host, each with a config of its own: fit@<name>
# runs /etc/fit/<name>.json, keeping its state in /var/lib/fit/<name>.
# Otherwise as fit.service; see deploy/README.md.
[Unit]
Description=fit, a reverse proxy and API gateway (%i)
Documentation=https://github.com/lesismal/fit
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=fit
Group=fit
ExecStartPre=/usr/local/bin/fit validate -c /etc/fit/%i.json
ExecStart=/usr/local/bin/fit run -c /etc/fit/%i.json
ExecReload=/usr/local/bin/fit validate -c /etc/fit/%i.json
ExecReload=/bin/kill -HUP $MAINPID
TimeoutStopSec=40
Restart=on-failure
RestartSec=2s
LimitNOFILE=1048576
UMask=0077

StateDirectory=fit/%i
RuntimeDirectory=fit/%i
ConfigurationDirectory=fit
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
