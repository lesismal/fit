  "comment": "The statements TestMySQLBinlogInterop runs on each server, and the rows the binlog must decode to. A step or a want with 'only' applies to the servers whose names start with one of its prefixes. A want's values are by column, [kind, text]; a column not named is null (or not in the image). The tables' columns say what a source would read from information_schema, for servers whose table maps lack the optional metadata.",
  "tables": [
    {
      "name": "num",
      "create": "CREATE TABLE num (id INT PRIMARY KEY, ti TINYINT, tu TINYINT UNSIGNED, si SMALLINT, su SMALLINT UNSIGNED, mi MEDIUMINT, mu MEDIUMINT UNSIGNED, i INT, iu INT UNSIGNED, bi BIGINT, bu BIGINT UNSIGNED, f FLOAT, d DOUBLE, d1 DECIMAL(10,2), d2 DECIMAL(65,30), d3 DECIMAL(5,0) UNSIGNED, b1 BIT(1), b13 BIT(13), b64 BIT(64), y YEAR)",
      "columns": [
        {"name": "id"}, {"name": "ti"}, {"name": "tu", "unsigned": true}, {"name": "si"}, {"name": "su", "unsigned": true},
        {"name": "mi"}, {"name": "mu", "unsigned": true}, {"name": "i"}, {"name": "iu", "unsigned": true},
        {"name": "bi"}, {"name": "bu", "unsigned": true}, {"name": "f"}, {"name": "d"}, {"name": "d1"}, {"name": "d2"},
