      ]
    },
    {
      "name": "tm",
      "create": "CREATE TABLE tm (id INT PRIMARY KEY, dt DATE, t0 TIME, t3 TIME(3), t6 TIME(6), dt0 DATETIME, dt2 DATETIME(2), dt6 DATETIME(6), ts0 TIMESTAMP NULL DEFAULT NULL, ts4 TIMESTAMP(4) NULL DEFAULT NULL, t1 TIME(1))",
      "columns": [
        {"name": "id"}, {"name": "dt"}, {"name": "t0"}, {"name": "t3"}, {"name": "t6"}, {"name": "dt0"}, {"name": "dt2"},
        {"name": "dt6"}, {"name": "ts0"}, {"name": "ts4"}, {"name": "t1"}
      ]
    },
    {
      "name": "str",
      "create": "CREATE TABLE str (id INT PRIMARY KEY, c CHAR(10), vc VARCHAR(300), cb BINARY(4), vb VARBINARY(10), tt TINYTEXT, tx TEXT, mt MEDIUMTEXT, lt LONGTEXT, tb TINYBLOB, bl BLOB, mb MEDIUMBLOB, lb LONGBLOB, e ENUM('a','b','c'), s SET('x','y','z'), g GEOMETRY, cw CHAR(255), l1 VARCHAR(10) CHARACTER SET latin1) DEFAULT CHARSET=utf8mb4",
      "columns": [
        {"name": "id"}, {"name": "c"}, {"name": "vc"}, {"name": "cb", "binary": true}, {"name": "vb", "binary": true},
        {"name": "tt"}, {"name": "tx"}, {"name": "mt"}, {"name": "lt"},
        {"name": "tb", "binary": true}, {"name": "bl", "binary": true}, {"name": "mb", "binary": true}, {"name": "lb", "binary": true},
        {"name": "e", "enum": ["a", "b", "c"]}, {"name": "s", "set": ["x", "y", "z"]}, {"name": "g", "binary": true}, {"name": "cw"}, {"name": "l1"}
      ]
    },
    {
      "name": "js",
      "create": "CREATE TABLE js (id INT PRIMARY KEY, j JSON)",
      "columns": [{"name": "id"}, {"name": "j"}]
    }
